@*
    StatusBadge — the single status chip for every grid/detail screen in the ERP.

    Status rendering logic lives here and ONLY here; screens never hand-roll their
    own colour switch. Callers pass the raw status (enum or string) and, optionally,
    display text when it differs from the enum name (InProgress → "In Progress"):

        <StatusBadge Status="@op.Status" Text="@op.StatusName" />
        <StatusBadge Status="@bill.Status" />
        <StatusBadge Status="@job.Status" Clickable="true" />   (pointer cursor)

    Status is typed as object so any module's enum works without this component
    taking a dependency on it (JobOperationStatus, BillStatus, VoucherStatus, …).
    Kind() normalises the value, so "In Progress", in_progress and InProgress all
    resolve to the same colour. Anything unmapped falls through to a neutral grey
    chip — a new enum member renders sanely rather than vanishing into the row.

    Colours are CSS tokens in app.css (.st-badge / .st-*), defined for both themes.
*@

<span class="st-badge st-@Kind(Status) @(Clickable ? "st-clickable" : null)">@(Text ?? Humanise(Status))</span>

@code {
    /// The status value — any enum member or string. Drives the colour only.
    [Parameter, EditorRequired] public object? Status { get; set; }

    /// Display text. Defaults to the status de-PascalCased ("InProgress" → "In Progress").
    [Parameter] public string? Text { get; set; }

    /// Set when the badge is wired to a click action — switches on the pointer cursor.
    [Parameter] public bool Clickable { get; set; }

    /// Colour slug for this status. Delegates to StatusKind — the one shared map.
    public static string Kind(object? status) => StatusKind.Of(status);

    /// "InProgress" → "In Progress"; leaves already-spaced text alone.
    private static string Humanise(object? status)
    {
        var s = status?.ToString();
        if (string.IsNullOrWhiteSpace(s)) return "—";

        var sb = new System.Text.StringBuilder(s.Length + 4);
        for (int i = 0; i < s.Length; i++)
        {
            if (i > 0 && char.IsUpper(s[i]) && !char.IsUpper(s[i - 1])) sb.Append(' ');
            sb.Append(s[i]);
        }
        return sb.ToString();
    }
}
