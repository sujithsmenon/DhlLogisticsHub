@inject JobOrderService Service
@inject LogisticsService Logistics
@inject CompanyBranchService BranchService
@inject PortService PortService
@inject CommodityService CommodityService
@inject ContainerSizeService ContainerSizeService
@inject StaffService StaffService
@inject CurrencyService CurrencyService
@inject ChargeCodeService ChargeCodeService
@inject SacService SacService
@inject JobOperationService OperationService
@inject IToastService ToastService

<style>
    .custom-modal .modal-dialog { max-width: min(95vw, 1800px) !important; width: min(95vw, 1800px); }
    @@media (max-width: 1200px) { .custom-modal .modal-dialog { max-width: 96vw !important; width: 96vw; } }
    .custom-scroll {
        max-height: 425px;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .custom-scroll::-webkit-scrollbar { width: 6px; }
    .custom-scroll::-webkit-scrollbar-thumb { background-color: rgba(0,0,0,0.3); border-radius: 4px; }
    .custom-scroll::-webkit-scrollbar-track { background: transparent; }
    .custom-scroll { scrollbar-width: thin; scrollbar-color: rgba(0,0,0,0.3) transparent; }
    .min-textarea textarea { min-height: 52px; }
    .normal-text { font-weight: 600; color: var(--text); }
    #Card { height: 165px !important; width: 100%; }
    .e-dialog .e-dlg-header { font-size: small; }
    .e-dialog.e-popup { max-height: fit-content !important; }
    .ops-scroll { width:100%; max-height:262px; overflow:auto; }
    .ops-table { width:100%; min-width:820px; font-size:12.5px; border-collapse:collapse; }
    .ops-table thead th { position:sticky; top:0; z-index:2; background:#198781; color:#fff;
                          padding:8px 9px; text-align:left; font-weight:700; white-space:nowrap; }
    .ops-table th.num, .ops-table td.num { text-align:right; }
    .ops-table td { padding:6px 9px; border-bottom:1px solid #e6e6e6; vertical-align:middle; }
    .ops-table .e-input-group, .ops-table .e-control-wrapper { height:36px !important; min-width:90px; }
    .ops-table .e-input-group input, .ops-table input.e-numerictextbox,
    .ops-table .e-input-group .e-input { height:34px !important; font-size:13px !important; }
    .ops-table .num input { text-align:right; }
    /* Sale-charges grid — job-scoped class names (jc-*) so these global rules can never
       collide with BillPopup's identically-named .charges-table / .charges-scroll styles. */
    .jc-scroll { width:100%; overflow:auto; max-height:40vh; border:1px solid var(--border); border-radius:6px; }
    .jc-table { width:100%; min-width:1880px; font-size:13px; border-collapse:collapse; }
    .jc-table thead th { position:sticky; top:0; z-index:3; background:#198781; color:#fff;
                              padding:9px 11px; text-align:left; font-weight:700; white-space:nowrap; }
    .jc-table th.num, .jc-table td.num { text-align:right; }
    .jc-table td { padding:7px 11px; border-bottom:1px solid #e6e6e6; vertical-align:middle; }
    .jc-table tfoot td { position:sticky; bottom:0; z-index:2; font-weight:700; background:var(--surface2); }
    .jc-table .e-input-group, .jc-table .e-control-wrapper { height:38px !important; min-width:100%; width:100%; }
    .jc-table .e-input-group input, .jc-table input.e-numerictextbox,
    .jc-table .e-input-group .e-input { height:36px !important; font-size:13.5px !important; }
    .jc-table .num input { text-align:right; }
    .jc-table .num .e-input-group { min-width:120px; }
    /* Job Operations tracking list (jop-*) — self-contained, does not touch charges/billing styling. */
    .jop-scroll { width:100%; overflow:auto; max-height:38vh; border:1px solid var(--border); border-radius:6px; }
    .jop-table { width:100%; min-width:960px; font-size:13px; border-collapse:collapse; }
    .jop-table thead th { position:sticky; top:0; z-index:2; background:#198781; color:#fff;
                          padding:8px 10px; text-align:left; font-weight:700; white-space:nowrap; }
    .jop-table td { padding:7px 10px; border-bottom:1px solid #e6e6e6; vertical-align:middle; }
    .jop-table tbody tr:hover { background:var(--surface2); }
    .jop-form { padding:12px; border:1px dashed var(--border); border-radius:6px; margin-bottom:10px; background:var(--surface2); }
</style>

<div class="modal-dialog modal-xl modal-dialog-centerd modal-dialog-scrollable modal-top-margin e-small custom-modal">
    <div class="modal-contentnew">
        <div class="modal-header">
            <h5 class="modal-title">Job Order Details</h5>
            <button type="button" class="btn-close e-small" @onclick="Close" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <EditForm Model="@item"><DataAnnotationsValidator />

                <!-- Row 1: Identity & parties -->
                <div class="row">
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Branch:</label>
                        <SfComboBox @bind-Value="@item.BranchId" TItem="CompanyBranch" TValue="int?"
                                    DataSource="@_branches" CssClass="e-small" ShowClearButton="true">
                            <ComboBoxFieldSettings Text="BranchName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Shipment Mode:</label>
                        <SfComboBox @bind-Value="@item.ShipmentMode" TItem="EnumItem<JobShipmentMode>" TValue="JobShipmentMode"
                                    DataSource="@_shipmentModes" CssClass="e-small" ShowClearButton="false">
                            <ComboBoxFieldSettings Text="Label" Value="Value" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Shipment Type:</label>
                        <SfComboBox @bind-Value="@item.ShipmentType" TItem="EnumItem<JobShipmentType>" TValue="JobShipmentType"
                                    DataSource="@_shipmentTypes" CssClass="e-small" ShowClearButton="false">
                            <ComboBoxFieldSettings Text="Label" Value="Value" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">JobOrder No:</label>
                        <SfTextBox Value="@(string.IsNullOrEmpty(item.JobOrderNo) ? "(auto on save)" : item.JobOrderNo)"
                                   CssClass="e-small" Enabled="false" />
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">JobOrder Date:</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="@item.JobOrderDate" Format="dd-MMM-yyyy" StrictMode="true" CssClass="e-small" />
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Customer Invoice No: <span style="color:#d9534f;">*</span></label>
                        <SfTextBox @bind-Value="@item.CustomerInvoiceNumber" CssClass="e-small" Placeholder="e.g. INV-45872" />
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Billing Client:</label>
                        <SfComboBox @bind-Value="@item.BillingClientId" TItem="DhlClient" TValue="int"
                                    DataSource="@_clients" AllowFiltering="true" CssClass="e-small" ShowClearButton="false"
                                    Placeholder="Select Organization..">
                            <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Status:</label>
                        <SfTextBox Value="@item.Status.ToString()" Enabled="false" CssClass="e-small" />
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Sales Staff:</label>
                        <SfComboBox @bind-Value="@item.SaleStaffId" TItem="Staff" TValue="int?"
                                    DataSource="@_staff" AllowFiltering="true" CssClass="e-small" ShowClearButton="true">
                            <ComboBoxFieldSettings Text="FullName" Value="Id" />
                        </SfComboBox>
                    </div>
                </div>

                <!-- Row 2: Routing & cargo -->
                <div class="row">
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Load @(item.ShipmentMode == JobShipmentMode.Air ? "Airport:" : "Port:")</label>
                        <SfComboBox @bind-Value="@item.LoadPortId" TItem="Port" TValue="int?"
                                    DataSource="@_ports" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                    Placeholder="Select Port..">
                            <ComboBoxFieldSettings Text="PortName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-3">
                        <label class="form-Custom-label">Discharge @(item.ShipmentMode == JobShipmentMode.Air ? "Airport:" : "Port:")</label>
                        <SfComboBox @bind-Value="@item.DischargePortId" TItem="Port" TValue="int?"
                                    DataSource="@_ports" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                    Placeholder="Select Port..">
                            <ComboBoxFieldSettings Text="PortName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-3">
                        <label class="form-Custom-label">Commodity:</label>
                        <SfComboBox @bind-Value="@item.CommodityId" TItem="Commodity" TValue="int?"
                                    DataSource="@_commodities" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                    Placeholder="Select Commodity..">
                            <ComboBoxFieldSettings Text="CommodityName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Cargo Type:</label>
                        <SfDropDownList @bind-Value="@item.CargoType" TItem="EnumItem<JobCargoType>" TValue="JobCargoType"
                                        DataSource="@_cargoTypes" CssClass="e-small" ShowClearButton="false">
                            <DropDownListFieldSettings Text="Label" Value="Value" />
                        </SfDropDownList>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">LCL Unit Type:</label>
                        <SfTextBox @bind-Value="@item.LclUnitType" CssClass="e-small" Placeholder="CBM/Pkgs"
                                   Enabled="@(item.CargoType == JobCargoType.LCL)" />
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Units:</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="@item.LclUnits" Format="N3" ShowSpinButton="false"
                                          CssClass="e-small" Enabled="@(item.CargoType == JobCargoType.LCL)" />
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">FCL Size:</label>
                        <SfComboBox @bind-Value="@item.ContainerSizeId" TItem="ContainerSize" TValue="int?"
                                    DataSource="@_containerSizes" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                    Enabled="@(item.CargoType == JobCargoType.FCL)">
                            <ComboBoxFieldSettings Text="SizeName" Value="Id" />
                        </SfComboBox>
                    </div>
                </div>

                <!-- Three cards: Shipment Info / Operations / Container & Charges -->
                <div class="row">
                    <!-- ── Card 1: Shipment Info ─────────────────────────────────────────── -->
                    <div class="col-md-5">
                        <div class="card">
                            <div class="card-header">Shipment Info</div>
                            <div class="card-body custom-scroll">
                                <div class="row mb-3">
                                    <div class="col-md-3"><label class="form-Custom-label">Cargo Description:</label></div>
                                    <div class="col-md-9">
                                        <SfTextBox CssClass="e-small min-textarea" @bind-Value="@item.CargoDescription"
                                                   Multiline="true" HtmlAttributes="@(new Dictionary<string, object> { { "rows", "3" } })" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3"><label class="form-Custom-label">Shipper:</label></div>
                                    <div class="col-md-9">
                                        <SfComboBox @bind-Value="@item.ShipperId" TItem="DhlClient" TValue="int"
                                                    DataSource="@_clients" AllowFiltering="true" CssClass="e-small" Placeholder="Select Organization..">
                                            <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                                        </SfComboBox>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3"><label class="form-Custom-label">Consignee:</label></div>
                                    <div class="col-md-9">
                                        <SfComboBox @bind-Value="@item.ConsigneeId" TItem="DhlClient" TValue="int"
                                                    DataSource="@_clients" AllowFiltering="true" CssClass="e-small" Placeholder="Select Organization..">
                                            <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                                        </SfComboBox>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3"><label class="form-Custom-label">Nominated:</label></div>
                                    <div class="col-md-3"><SfCheckBox @bind-Checked="@item.IsNominated" Label="Yes" /></div>
                                    <div class="col-md-3"><label class="form-Custom-label">Emergency:</label></div>
                                    <div class="col-md-3"><SfCheckBox @bind-Checked="@item.IsEmergency" Label="Yes" /></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6"><label class="form-Custom-label">Transportation:</label></div>
                                    <div class="col-md-6">
                                        <SfCheckBox @bind-Checked="@item.RequiresTransportation" Label="Raise a linked Transportation (TB) bill" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Card 2: Job Operations (main operations area) ──────────────────── -->
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header d-flex align-items-center" style="padding:4px 10px;">
                                <span><b>Operations</b></span>
                                <div class="ms-auto">
                                    <SfButton OnClick="@(() => OpenOperationDialog(0))" CssClass="e-small" IconCss="e-icons e-add" IsPrimary="true">Add</SfButton>
                                </div>
                            </div>
                            <div class="card-body custom-scroll" style="height:280px;padding:6px;">
                                @if (Id == 0)
                                {
                                    <p class="muted" style="font-size:11px;text-align:center;padding-top:60px;">
                                        Save the Job Order first, then<br/>add its operations here.
                                    </p>
                                }
                                else if (_operations.Count == 0)
                                {
                                    <p class="muted" style="font-size:11px;text-align:center;padding-top:60px;">
                                        No operations yet. Click <b>Add</b> to<br/>record an operation for this job.
                                    </p>
                                }
                                else
                                {
                                    <div class="jop-scroll">
                                    <table class="jop-table">
                                        <thead>
                                            <tr>
                                                <th style="width:36px;">#</th>
                                                <th style="min-width:160px;">Operation Type</th>
                                                <th style="min-width:110px;">Department</th>
                                                <th style="min-width:120px;">Vendor</th>
                                                <th style="min-width:140px;">Assigned Staff</th>
                                                <th style="width:110px;">Status</th>
                                                <th style="width:90px;">Priority</th>
                                                <th style="width:115px;">Planned Date</th>
                                                <th style="width:115px;">Actual Date</th>
                                                <th style="min-width:160px;">Remarks</th>
                                                <th style="width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var op in _operations)
                                            {
                                                <tr>
                                                    <td>@op.SequenceNo</td>
                                                    <td>@op.OperationType</td>
                                                    <td>@(string.IsNullOrWhiteSpace(op.Department) ? "—" : op.Department)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(op.VendorName) ? "—" : op.VendorName)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(op.AssignedStaffName) ? "—" : op.AssignedStaffName)</td>
                                                    <td><StatusBadge Status="@op.Status" Text="@op.StatusName" /></td>
                                                    <td>@op.PriorityName</td>
                                                    <td>@(op.PlannedDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</td>
                                                    <td>@(op.ActualDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(op.Remarks) ? "—" : op.Remarks)</td>
                                                    <td style="white-space:nowrap;">
                                                        @if (_confirmDeleteId == op.Id)
                                                        {
                                                            <span style="font-size:11px;margin-right:4px;">Delete?</span>
                                                            <SfButton OnClick="@(() => DeleteOperation(op.Id))" CssClass="e-small delete-btn" IconCss="e-icons e-check" Title="Confirm delete" />
                                                            <SfButton OnClick="@(() => _confirmDeleteId = null)" CssClass="e-small" IconCss="e-icons e-close" Title="Cancel" />
                                                        }
                                                        else
                                                        {
                                                            <SfButton OnClick="@(() => OpenOperationDialog(op.Id))" CssClass="e-small" IconCss="e-icons e-edit" Title="Edit" />
                                                            <SfButton OnClick="@(() => _confirmDeleteId = op.Id)" CssClass="e-small delete-btn" IconCss="e-icons e-delete" Title="Delete" />
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ── Card 3: Container & Charges ───────────────────────────────────── -->
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-header">Cargo Totals</div>
                            <div class="card-body">
                                <div class="mb-3"><label class="form-Custom-label">Gross Wt (kg):</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.GrossWeightKg" Format="N3" CssClass="e-small" /></div>
                                <div class="mb-3"><label class="form-Custom-label">Volume (CBM):</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.VolumeCbm" Format="N3" CssClass="e-small" /></div>
                                <div class="mb-3"><label class="form-Custom-label">Currency:</label>
                                    <SfComboBox @bind-Value="@item.CurrencyId" TItem="Currency" TValue="int?"
                                                DataSource="@_currencies" AllowFiltering="true" CssClass="e-small" ShowClearButton="true">
                                        <ComboBoxFieldSettings Text="CurrencyCode" Value="Id" />
                                    </SfComboBox>
                                </div>
                                <div class="mb-3"><label class="form-Custom-label">Est. Value:</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.EstimatedValue" Format="N2" CssClass="e-small" /></div>
                                <div class="mb-3"><label class="form-Custom-label">Remarks:</label>
                                    <SfTextBox @bind-Value="@item.Remarks" CssClass="e-small" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Sale Charges — copied into the linked bill on approval ─────────────── -->
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        <span><b>Charges</b> <small class="muted">— billed to the customer; flow into the auto-generated bill on approval</small></span>
                        <div class="ms-auto">
                            <SfButton OnClick="@AddCharge" CssClass="e-small" IconCss="e-icons e-add" IsPrimary="true">Add Charge</SfButton>
                        </div>
                    </div>
                    <div class="card-body" style="padding:6px;">
                        @if (item.Charges.Count == 0)
                        {
                            <p class="muted" style="text-align:center;padding:14px 0;">No charges yet. Click <b>Add Charge</b> to add billable lines.</p>
                        }
                        else
                        {
                            <div class="jc-scroll">
                            <table class="jc-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th style="width:160px;">Category</th>
                                        <th style="width:200px;">Operation</th>
                                        <th style="width:260px;">Charge Code</th>
                                        <th style="width:180px;">SAC</th>
                                        <th style="min-width:320px;">Description</th>
                                        <th style="width:140px;" class="num">Qty</th>
                                        <th style="width:150px;" class="num">Rate</th>
                                        <th style="width:150px;" class="num">Amount</th>
                                        <th style="width:130px;" class="num">GST %</th>
                                        <th style="width:150px;" class="num">GST Amt</th>
                                        <th style="width:160px;" class="num">Net Amount</th>
                                        <th style="width:52px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < item.Charges.Count; i++)
                                    {
                                        var idx = i;
                                        var c = item.Charges[idx];
                                        <tr>
                                            <td>@(idx + 1)</td>
                                            <td>
                                                <SfComboBox TItem="ChargeCategory" TValue="ChargeCategory" DataSource="@_chargeCategories"
                                                            Value="@c.Category" CssClass="e-small"
                                                            ValueChanged="@((ChargeCategory v) => { c.Category = v; Recalc(); })" />
                                            </td>
                                            <td>
                                                <SfComboBox TItem="JobOperationDto" TValue="long?" DataSource="@_operations"
                                                            @bind-Value="@c.JobOperationId" CssClass="e-small" ShowClearButton="true"
                                                            AllowFiltering="true" Placeholder="General">
                                                    <ComboBoxFieldSettings Text="OperationType" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td>
                                                <SfComboBox TItem="ChargeCode" TValue="int?" DataSource="@_chargeCodes"
                                                            Value="@c.ChargeCodeId" CssClass="e-small" ShowClearButton="true"
                                                            ValueChanged="@((int? v) => OnChargeCodePicked(idx, v))" AllowFiltering="true">
                                                    <ComboBoxFieldSettings Text="ChargeName" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td>
                                                <SfComboBox TItem="Sac" TValue="int?" DataSource="@_sacs"
                                                            @bind-Value="@c.SacId" CssClass="e-small" ShowClearButton="true" AllowFiltering="true">
                                                    <ComboBoxFieldSettings Text="SacCode" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td><SfTextBox @bind-Value="@c.Description" CssClass="e-small" /></td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.Quantity" CssClass="e-small" Format="N3" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.Quantity = v; Recalc(); })" />
                                            </td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.Rate" CssClass="e-small" Format="N4" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.Rate = v; Recalc(); })" />
                                            </td>
                                            <td class="num">@c.Amount.ToString("N2")</td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.GstRate" CssClass="e-small" Format="N2" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.GstRate = v; Recalc(); })" />
                                            </td>
                                            <td class="num">@c.GstAmount.ToString("N2")</td>
                                            <td class="num">@c.NetAmount.ToString("N2")</td>
                                            <td><SfButton OnClick="@(() => RemoveCharge(idx))" CssClass="e-small delete-btn" IconCss="e-icons e-delete" /></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="8" style="text-align:right;">Totals:</td>
                                        <td class="num">@item.SubTotal.ToString("N2")</td>
                                        <td></td>
                                        <td class="num">@item.GstTotal.ToString("N2")</td>
                                        <td class="num">@item.TotalAmount.ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- ── Operation Costs (Vendor) — what we PAY per operation; posts expense/payable on approval ── -->
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        <span><b>Operation Costs (Vendor)</b> <small class="muted">— vendor cost we pay per operation; posts an expense/payable voucher on approval</small></span>
                        <div class="ms-auto">
                            <SfButton OnClick="@AddOperation" CssClass="e-small" IconCss="e-icons e-add" IsPrimary="true">Add Cost</SfButton>
                        </div>
                    </div>
                    <div class="card-body" style="padding:6px;">
                        @if (item.Operations.Count == 0)
                        {
                            <p class="muted" style="text-align:center;padding:14px 0;">No vendor costs yet. Click <b>Add Cost</b> to record a vendor cost line for this job.</p>
                        }
                        else
                        {
                            <div class="ops-scroll">
                            <table class="ops-table">
                                <thead>
                                    <tr>
                                        <th style="width:32px;">#</th>
                                        <th style="min-width:170px;">Operation</th>
                                        <th style="min-width:180px;">Operated By (Vendor)</th>
                                        <th style="min-width:150px;">Staff</th>
                                        <th style="width:140px;">Exp. Head</th>
                                        <th style="width:120px;" class="num">Cost</th>
                                        <th style="width:44px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < item.Operations.Count; i++)
                                    {
                                        var idx = i;
                                        var op = item.Operations[idx];
                                        <tr>
                                            <td>@(idx + 1)</td>
                                            <td><SfTextBox @bind-Value="@op.OperationName" CssClass="e-small" Placeholder="e.g. Customs Clearance" /></td>
                                            <td>
                                                <SfComboBox @bind-Value="@op.OperatedByClientId" TItem="DhlClient" TValue="int?"
                                                            DataSource="@_clients" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                                            Placeholder="In-house">
                                                    <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td>
                                                <SfComboBox @bind-Value="@op.HandledByStaffId" TItem="Staff" TValue="int?"
                                                            DataSource="@_staff" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                                            Placeholder="Staff">
                                                    <ComboBoxFieldSettings Text="FullName" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td>
                                                <SfComboBox @bind-Value="@op.ExpenseCategory" TItem="ChargeCategory" TValue="ChargeCategory"
                                                            DataSource="@_expenseCategories" CssClass="e-small" />
                                            </td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal?" @bind-Value="@op.Cost" CssClass="e-small" Format="N2" ShowSpinButton="false" />
                                            </td>
                                            <td><SfButton OnClick="@(() => RemoveOperation(idx))" CssClass="e-small delete-btn" IconCss="e-icons e-delete" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        }
                    </div>
                </div>

                <BsModalDialog @ref="_opModal" />

                @if (item.Status == JobOrderStatus.Rejected && !string.IsNullOrEmpty(item.RejectionReason))
                {
                    <div class="alert alert-warning" style="padding:6px 10px;font-size:12px;margin-top:8px;">
                        <strong>Rejected:</strong> @item.RejectionReason
                        (by @item.RejectedBy on @(item.RejectedOn?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")))
                    </div>
                }
            </EditForm>
        </div>

        <div class="modal-footer">
            <div class="row bs" style="width:100%;">
                <div class="col-md-12" style="text-align:center;">
                    <div class="row" style="padding-top:5px;">
                        <div class="mb-3 col-md-5">
                            <div class="row text-start">
                                <div class="mb-3 col-md-4"><label class="form-Custom-label">Created By:</label></div>
                                <div class="mb-3 col-md-8">
                                    <label class="form-Custom-label" title="@(item.CreatedOn.ToLocalTime().ToString("dd-MMM-yyyy HH:mm:ss"))">
                                        <span class="normal-text">@item.CreatedBy</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2" style="text-align:center;">
                            @if (Id != 0 && item.Status == JobOrderStatus.Draft)
                            {
                                <SfButton OnClick="@Submit" CssClass="e-small" IconCss="e-icons e-send-1">Submit</SfButton>
                            }
                            <SfButton IsPrimary="true" OnClick="@Save" CssClass="e-small" IconCss="e-icons e-save-as">@btnText</SfButton>
                            <SfButton OnClick="@Close" CssClass="e-small" IconCss="e-icons e-circle-close">Close</SfButton>
                        </div>
                        <div class="mb-3 col-md-5">
                            <div class="row text-start">
                                <div class="mb-3 col-md-4"><label class="form-Custom-label">Modified By:</label></div>
                                <div class="mb-3 col-md-8">
                                    <label class="form-Custom-label" title="@(item.ModifiedOn?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm:ss") ?? "")">
                                        <span class="normal-text">@item.ModifiedBy</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public record EnumItem<T>(T Value, string Label);

    [CascadingParameter] private IModalDialogContext? Modal { get; set; }
    [Parameter] public EventCallback LoadOnSaveReference { get; set; }
    [Parameter] public long Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public JobMode Mode { get; set; } = JobMode.Clearance;

    private JobOrder item = new();
    private string btnText => Id == 0 ? "Save" : "Update";

    private List<DhlClient>      _clients         = new();
    private List<Port>           _ports           = new();
    private List<Commodity>      _commodities     = new();
    private List<ContainerSize>  _containerSizes  = new();
    private List<Staff>          _staff           = new();
    private List<Currency>       _currencies      = new();
    private List<CompanyBranch>  _branches        = new();
    private List<ChargeCode>     _chargeCodes     = new();
    private List<Sac>            _sacs            = new();

    private static readonly ChargeCategory[] _chargeCategories =
        (ChargeCategory[])Enum.GetValues(typeof(ChargeCategory));

    // ── Job Operations (JobOperation tracking entity) ─────────────────────────
    private List<JobOperationDto> _operations = new();
    private BsModalDialog? _opModal;
    private long? _confirmDeleteId;

    private static readonly List<EnumItem<JobShipmentMode>> _shipmentModes = new()
    {
        new(JobShipmentMode.Sea,  "Sea"),
        new(JobShipmentMode.Air,  "Air"),
        new(JobShipmentMode.Road, "Road"),
    };
    private static readonly List<EnumItem<JobShipmentType>> _shipmentTypes = new()
    {
        new(JobShipmentType.Import, "Import"),
        new(JobShipmentType.Export, "Export"),
    };
    private static readonly List<EnumItem<JobCargoType>> _cargoTypes = new()
    {
        new(JobCargoType.FCL,   "FCL"),
        new(JobCargoType.LCL,   "LCL"),
        new(JobCargoType.Air,   "Air"),
        new(JobCargoType.Bulk,  "Bulk"),
        new(JobCargoType.Break, "Break Bulk"),
    };

    protected override async Task OnInitializedAsync()
    {
        _branches       = await BranchService.GetAllAsync();
        _clients        = await Logistics.GetAllClientsAsync();
        _ports          = await PortService.GetAllAsync();
        _commodities    = await CommodityService.GetAllAsync();
        _containerSizes = await ContainerSizeService.GetAllAsync();
        _staff          = await StaffService.GetAllAsync();
        _currencies     = await CurrencyService.GetAllAsync();
        _chargeCodes    = await ChargeCodeService.GetAllAsync();
        _sacs           = await SacService.GetAllAsync();

        if (Id != 0)
        {
            var e = await Service.GetByIdAsync(Id);
            if (e is not null) { item = e; JobOrderService.RecalcTotals(item); }
            await LoadOperationsAsync();
        }
        else
        {
            item = new JobOrder { Mode = Mode, JobOrderDate = DateTime.UtcNow.Date };
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(item.CustomerInvoiceNumber)) { Toast("Customer Invoice No is required."); return; }
        if (item.BillingClientId == 0) { Toast("Billing Client is required."); return; }
        if (item.ShipperId == 0)       { Toast("Shipper is required."); return; }
        if (item.ConsigneeId == 0)     { Toast("Consignee is required."); return; }

        item.CustomerInvoiceNumber = item.CustomerInvoiceNumber.Trim();

        try
        {
            if (Id == 0)
            {
                item.Mode = Mode;
                await Service.CreateAsync(item);
            }
            else
            {
                await Service.UpdateAsync(item);
            }
            ToastService.Show(new() { Title = "Success!", Content = "Job Order saved.", CssClass = "e-toast-success" });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
            this.Modal?.Close(ModalResult.OK());
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    private static readonly ChargeCategory[] _expenseCategories =
        (ChargeCategory[])Enum.GetValues(typeof(ChargeCategory));

    private void AddOperation() =>
        item.Operations.Add(new JobOrderOperation { DisplayOrder = item.Operations.Count + 1 });

    private void RemoveOperation(int idx)
    {
        if (idx < 0 || idx >= item.Operations.Count) return;
        item.Operations.RemoveAt(idx);
    }

    // ── Job Operations (JobOperation) — self-contained CRUD, persisted directly via
    //    JobOperationService and independent of the job Save button / workflow ─────────
    private async Task LoadOperationsAsync()
    {
        _operations = await OperationService.GetByJobOrderAsync(Id);
    }

    // Add (id == 0) / Edit — opens the JobOperationPopup dialog. Persistence happens inside the
    // dialog (JobOperationService) and is independent of the job Save button / workflow / billing.
    private async Task OpenOperationDialog(long id)
    {
        if (Id == 0) { Toast("Save the Job Order first to add operations."); return; }
        _confirmDeleteId = null;

        var o = new BsModalOptions();
        o.ControlParameters.Add("Id", id);
        o.ControlParameters.Add("JobOrderId", Id);
        var r = await _opModal!.Context.ShowAsync<JobOperationPopup>(o);
        if (r.ResultType == ModalResultType.OK) await LoadOperationsAsync();
    }

    private async Task DeleteOperation(long id)
    {
        try
        {
            await OperationService.DeleteAsync(id);
            _confirmDeleteId = null;
            await LoadOperationsAsync();
            ToastService.Show(new() { Title = "Deleted", Content = "Operation removed.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    // ── Sale charges (flow into the linked bill on approval) ──────────────────
    private void AddCharge()
    {
        item.Charges.Add(new JobCharge { Quantity = 1m, DisplayOrder = item.Charges.Count + 1 });
        Recalc();
    }

    private void RemoveCharge(int idx)
    {
        if (idx < 0 || idx >= item.Charges.Count) return;
        item.Charges.RemoveAt(idx);
        Recalc();
    }

    private void OnChargeCodePicked(int idx, int? chargeCodeId)
    {
        if (idx < 0 || idx >= item.Charges.Count) return;
        var c = item.Charges[idx];
        c.ChargeCodeId = chargeCodeId;
        if (chargeCodeId.HasValue)
        {
            var cc = _chargeCodes.FirstOrDefault(x => x.Id == chargeCodeId);
            if (cc is not null)
            {
                if (string.IsNullOrWhiteSpace(c.Description)) c.Description = cc.ChargeName;
                if (c.Rate == 0 && cc.DefaultAmount > 0)      c.Rate = cc.DefaultAmount;
                if (cc.SacId.HasValue)                         c.SacId = cc.SacId;
                if (c.GstRate == 0 && cc.Sac is not null)      c.GstRate = cc.Sac.GstRate;
            }
        }
        Recalc();
    }

    private void Recalc() => JobOrderService.RecalcTotals(item);

    private async Task Submit()
    {
        try
        {
            await Service.SubmitAsync(Id);
            ToastService.Show(new() { Title = "Submitted", Content = "Job sent for verification.", CssClass = "e-toast-success" });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
            this.Modal?.Close(ModalResult.OK());
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    private void Toast(string msg) =>
        ToastService.Show(new() { Title = "Validation", Content = msg, CssClass = "e-toast-danger" });

    private void Close() => this.Modal?.Close(ModalResult.Cancel());
}
