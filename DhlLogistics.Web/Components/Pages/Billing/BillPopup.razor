@inject BillService Service
@inject JobOrderService JobOrderService
@inject LogisticsService Logistics
@inject CompanyBranchService BranchService
@inject CurrencyService CurrencyService
@inject ChargeCodeService ChargeCodeService
@inject SacService SacService
@inject InvoiceService InvoiceService
@inject TransportationBillService TransportService
@inject IToastService ToastService

<style>
    /* Wide, responsive dialog so the full charge grid fits on desktop/tablet. */
    .custom-modal .modal-dialog { max-width: min(95vw, 1800px) !important; width: min(95vw, 1800px); }
    /* Scroll wrapper: horizontal scroll when needed; sticky header stays visible. */
    .charges-scroll { width:100%; overflow:auto; max-height:52vh; border:1px solid var(--border); border-radius:6px; }
    .charges-table { width:100%; min-width:1900px; font-size:13px; border-collapse:collapse; }
    .charges-table thead th { position:sticky; top:0; z-index:3; background:#198781; color:#fff;
                              padding:10px 8px; text-align:left; font-weight:700; white-space:nowrap; }
    .charges-table th.num, .charges-table td.num { text-align:right; }
    .charges-table td { padding:6px 8px; border-bottom:1px solid #e6e6e6; vertical-align:middle; }
    .charges-table tfoot td { position:sticky; bottom:0; z-index:2; font-weight:700; background:var(--surface2); }
    /* Operation grouping band inside the charges grid. */
    .charges-table tr.op-group-row td { background:#eef6f5; color:#14706b; font-weight:700;
                                        font-size:12px; letter-spacing:.02em; padding:6px 10px; border-bottom:1px solid #cfe6e3; }
    /* Editors: taller (≈40px), larger font, never clip the value; wide enough for the full number. */
    .charges-table .e-input-group, .charges-table .e-control-wrapper { height:40px !important; min-width:0; width:100%; box-sizing:border-box; }
    .charges-table .e-input-group input, .charges-table input.e-numerictextbox,
    .charges-table .e-input-group .e-input { height:38px !important; font-size:14px !important; }
    .charges-table .num input { text-align:right; }
    /* Numeric editors have no spin buttons (see markup) so the value uses the full cell width. */
    .charges-table .num .e-input-group { min-width:0; width:100%; }
    /* Display-only numeric cells must never clip their value. */
    .charges-table td.num { white-space:nowrap; }
    @@media (max-width: 1200px) { .custom-modal .modal-dialog { max-width: 96vw !important; width: 96vw; } }
    .billed-by { color:var(--text); font-weight:600; }
    .job-link-card { margin-bottom:8px; }
    .job-link-body { display:grid; grid-template-columns:repeat(4,1fr); gap:4px 14px; padding:8px 10px; font-size:12px; }
    .job-link-body .jl { display:flex; flex-direction:column; line-height:1.2; }
    .job-link-body .jl span { color:var(--muted,#888); font-size:10.5px; text-transform:uppercase; letter-spacing:.03em; }
    .invoice-panel { margin-top:14px; border:1px solid var(--border); border-radius:8px; overflow:hidden; }
    .invoice-hdr { background:linear-gradient(135deg,#198781 0%,#14706b 100%); color:#fff; font-weight:700;
                   padding:8px 12px; display:flex; align-items:center; justify-content:space-between; font-size:13px; }
    .invoice-body { padding:14px 16px; }
    .inv-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px 18px; }
    .inv-field { display:flex; flex-direction:column; gap:3px; }
    .inv-field-wide { grid-column:span 2; }
    .inv-lbl { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--muted,#5A6573); }
    .inv-val { font-weight:700; font-size:14px; color:var(--text,#0E2A47); min-height:20px; }
    .inv-actions { display:flex; align-items:center; gap:10px; flex-wrap:wrap;
                   margin-top:14px; padding-top:12px; border-top:1px dashed var(--border); }
    .inv-sep { flex:1 1 12px; }
    .inv-status { font-size:11px; font-weight:700; padding:3px 12px; border-radius:12px; background:#e2e8f0; color:#334155; }
    .inv-status.inv-issued { background:#dcfce7; color:#166534; }
    .inv-status.inv-cancelled { background:#fee2e2; color:#991b1b; }
    @@media (max-width: 900px) { .inv-field-wide { grid-column:span 1; } }
</style>

<div class="modal-dialog modal-xl modal-dialog-centerd modal-dialog-scrollable modal-top-margin e-small custom-modal">
    <div class="modal-contentnew">
        <div class="modal-header">
            <h5 class="modal-title">@Title</h5>
            <button type="button" class="btn-close e-small" @onclick="Close" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <EditForm Model="@item"><DataAnnotationsValidator />

                <!-- Header row -->
                <div class="row">
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Branch:</label>
                        <SfComboBox @bind-Value="@item.BranchId" TItem="CompanyBranch" TValue="int?"
                                    DataSource="@_branches" CssClass="e-small" ShowClearButton="true">
                            <ComboBoxFieldSettings Text="BranchName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Bill No:</label>
                        <SfTextBox Value="@(string.IsNullOrEmpty(item.BillNo) ? "(auto on save)" : item.BillNo)"
                                   CssClass="e-small" Enabled="false" />
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Bill Date:</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="@item.BillDate" Format="dd-MMM-yyyy" StrictMode="true" CssClass="e-small" />
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Billing Client:</label>
                        <SfComboBox @bind-Value="@item.BillingClientId" TItem="DhlClient" TValue="int"
                                    DataSource="@_clients" AllowFiltering="true" CssClass="e-small" ShowClearButton="false"
                                    Placeholder="Select Organization..">
                            <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Customer Invoice:</label>
                        <SfTextBox @bind-Value="@item.CustomerInvoiceNumber" CssClass="e-small" Placeholder="Customer's invoice ref" />
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-Custom-label">Job Order:</label>
                        <SfComboBox TItem="JobOrder" TValue="long?" Value="@item.JobOrderId"
                                    DataSource="@_jobs" AllowFiltering="true" CssClass="e-small" ShowClearButton="true"
                                    Placeholder="Optional.." ValueChanged="@OnJobPicked">
                            <ComboBoxFieldSettings Text="JobOrderNo" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Currency:</label>
                        <SfComboBox @bind-Value="@item.CurrencyId" TItem="Currency" TValue="int?"
                                    DataSource="@_currencies" AllowFiltering="true" CssClass="e-small" ShowClearButton="true">
                            <ComboBoxFieldSettings Text="CurrencyCode" Value="Id" />
                        </SfComboBox>
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Ex Rate:</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="@item.ExchangeRate" Format="N4" CssClass="e-small" Min="0" />
                    </div>
                    <div class="mb-3 col-md-1">
                        <label class="form-Custom-label">Status:</label>
                        <SfTextBox Value="@item.Status.ToString()" Enabled="false" CssClass="e-small" />
                    </div>
                </div>

                <!-- Linked parent Job (read-only — pulled through FK, never duplicated) -->
                @if (_job is not null)
                {
                    <div class="card job-link-card">
                        <div class="card-header d-flex align-items-center" style="padding:4px 10px;">
                            <span><b>Linked Job</b> — <span class="billed-by">@_job.JobOrderNo</span></span>
                        </div>
                        <div class="card-body job-link-body">
                            <div class="jl"><span>Job Date</span><b>@_job.JobOrderDate.ToString("dd-MMM-yyyy")</b></div>
                            <div class="jl"><span>Mode</span><b>@_job.Mode / @_job.ShipmentMode / @_job.ShipmentType</b></div>
                            <div class="jl"><span>Activity</span><b>@_job.ShipmentType (@_job.CargoType)</b></div>
                            <div class="jl"><span>Customer</span><b>@(_job.BillingClient?.CompanyName ?? "-")</b></div>
                            <div class="jl"><span>Branch</span><b>@(_job.Branch?.BranchName ?? "-")</b></div>
                            <div class="jl"><span>Shipper</span><b>@(_job.Shipper?.CompanyName ?? "-")</b></div>
                            <div class="jl"><span>Consignee</span><b>@(_job.Consignee?.CompanyName ?? "-")</b></div>
                            <div class="jl"><span>Commodity</span><b>@(_job.Commodity?.CommodityName ?? "-")</b></div>
                            <div class="jl"><span>Container</span><b>@(_job.ContainerSize?.SizeName ?? _job.CargoDescription)</b></div>
                            <div class="jl"><span>Load Port</span><b>@(_job.LoadPort?.PortName ?? "-")</b></div>
                            <div class="jl"><span>Discharge Port</span><b>@(_job.DischargePort?.PortName ?? "-")</b></div>
                            <div class="jl"><span>Currency</span><b>@(_job.Currency?.CurrencyCode ?? "-")</b></div>
                            <div class="jl"><span>Gross Wt (kg)</span><b>@(_job.GrossWeightKg?.ToString("N3") ?? "—")</b></div>
                            <div class="jl"><span>Volume (CBM)</span><b>@(_job.VolumeCbm?.ToString("N3") ?? "—")</b></div>
                            <div class="jl"><span>Est. Cargo Value</span><b>@(_job.EstimatedValue?.ToString("N2") ?? "—")</b></div>
                            <div class="jl"><span>Remarks</span><b>@(string.IsNullOrWhiteSpace(_job.Remarks) ? "—" : _job.Remarks)</b></div>
                        </div>
                    </div>
                }

                @* Full traceability from this bill: its billing group, sibling bills, originating records,
                   the consolidated customer invoice and every PDF. Same component everywhere. *@
                @if (Id != 0 && !string.IsNullOrWhiteSpace(item.CustomerInvoiceNumber))
                {
                    <div style="margin-bottom:10px;">
                        <LinkedDocumentsPanel CustomerInvoiceNumber="@item.CustomerInvoiceNumber"
                                              OnNavigate="@(_ => { Modal?.Close(ModalResult.Cancel()); return Task.CompletedTask; })" />
                    </div>
                }

                @* ── Transport Details — the source snapshot (AWB/BL, container, vehicle, driver, route, cargo).
                     Shown for Transportation bills and any bill carrying source detail. Editable; saved on the
                     Bill so the record is self-contained regardless of shipment type. ── *@
                @if (item.Mode == BillMode.Transportation || item.SourceType is not null)
                {
                    <div class="card" style="margin-bottom:8px;">
                        <div class="card-header d-flex align-items-center">
                            <span><b>Transport Details</b>
                                @if (!string.IsNullOrWhiteSpace(item.SourceReference))
                                {
                                    <small class="muted"> — @item.ShipmentTypeName · @item.SourceReference</small>
                                }
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">AWB / BL No:</label>
                                    <SfTextBox @bind-Value="@item.AwbOrBlNumber" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Container No:</label>
                                    <SfTextBox @bind-Value="@item.ContainerNumber" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Transporter:</label>
                                    <SfComboBox @bind-Value="@item.TransporterId" TItem="Transporter" TValue="int?"
                                                DataSource="@_transporters" AllowFiltering="true" CssClass="e-small" ShowClearButton="true">
                                        <ComboBoxFieldSettings Text="CompanyName" Value="Id" />
                                    </SfComboBox></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Commodity:</label>
                                    <SfTextBox @bind-Value="@item.CommodityName" CssClass="e-small" /></div>
                            </div>
                            <div class="row">
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Vehicle No:</label>
                                    <SfTextBox @bind-Value="@item.VehicleNumber" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Driver:</label>
                                    <SfTextBox @bind-Value="@item.DriverName" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Origin:</label>
                                    <SfTextBox @bind-Value="@item.Origin" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Destination:</label>
                                    <SfTextBox @bind-Value="@item.Destination" CssClass="e-small" /></div>
                            </div>
                            <div class="row">
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Pickup Location:</label>
                                    <SfTextBox @bind-Value="@item.PickupLocation" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-3"><label class="form-Custom-label">Delivery Location:</label>
                                    <SfTextBox @bind-Value="@item.DeliveryLocation" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-2"><label class="form-Custom-label">Quantity:</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.Quantity" Format="N3" ShowSpinButton="false" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-2"><label class="form-Custom-label">Weight (kg):</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.WeightKg" Format="N3" ShowSpinButton="false" CssClass="e-small" /></div>
                                <div class="mb-2 col-md-2"><label class="form-Custom-label">Volume (CBM):</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="@item.VolumeCbm" Format="N3" ShowSpinButton="false" CssClass="e-small" /></div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Charges card -->
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        <span><b>Charges</b></span>
                        <div class="ms-auto">
                            <SfButton OnClick="@AddCharge" CssClass="e-small" IconCss="e-icons e-add" IsPrimary="true">Add Charge</SfButton>
                        </div>
                    </div>
                    <div class="card-body" style="padding:6px;">
                        @if (item.Charges.Count == 0)
                        {
                            <p class="muted" style="text-align:center;padding:18px 0;">No charges yet. Click <b>Add Charge</b>.</p>
                        }
                        else
                        {
                            <div class="charges-scroll">
                            <table class="charges-table">
                                <thead>
                                    <tr>
                                        <th style="width:44px;">#</th>
                                        <th style="width:150px;">Category</th>
                                        <th style="width:240px;">Charge Code</th>
                                        <th style="width:170px;">SAC</th>
                                        <th style="min-width:300px;">Description</th>
                                        <th style="width:150px;" class="num">Qty</th>
                                        <th style="width:160px;" class="num">Rate</th>
                                        <th style="width:150px;" class="num">Amount</th>
                                        <th style="width:140px;" class="num">GST %</th>
                                        <th style="width:160px;" class="num">GST Amt</th>
                                        <th style="width:175px;" class="num">Net Amount</th>
                                        <th style="width:60px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in GroupedCharges())
                                    {
                                        <tr class="op-group-row">
                                            <td colspan="12">@(g.Key == GeneralGroup ? g.Key : "Operation: " + g.Key)</td>
                                        </tr>
                                        @foreach (var entry in g)
                                        {
                                            var idx = entry.Index;
                                            var c = entry.Charge;
                                            <tr>
                                            <td>@(idx + 1)</td>
                                            <td>
                                                <SfComboBox TItem="ChargeCategory" TValue="ChargeCategory" DataSource="@_categories"
                                                            Value="@c.Category" CssClass="e-small"
                                                            ValueChanged="@((ChargeCategory v) => { c.Category = v; Recalc(); })" />
                                            </td>
                                            <td>
                                                <SfComboBox TItem="ChargeCode" TValue="int?" DataSource="@_chargeCodes"
                                                            Value="@c.ChargeCodeId" CssClass="e-small" ShowClearButton="true"
                                                            ValueChanged="@((int? v) => OnChargeCodePicked(idx, v))"
                                                            AllowFiltering="true">
                                                    <ComboBoxFieldSettings Text="ChargeName" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td>
                                                <SfComboBox TItem="Sac" TValue="int?" DataSource="@_sacs"
                                                            @bind-Value="@c.SacId" CssClass="e-small" ShowClearButton="true"
                                                            AllowFiltering="true">
                                                    <ComboBoxFieldSettings Text="SacCode" Value="Id" />
                                                </SfComboBox>
                                            </td>
                                            <td><SfTextBox @bind-Value="@c.Description" CssClass="e-small" /></td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.Quantity" CssClass="e-small" Format="N3" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.Quantity = v; Recalc(); })" />
                                            </td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.Rate" CssClass="e-small" Format="N4" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.Rate = v; Recalc(); })" />
                                            </td>
                                            <td class="num">@c.Amount.ToString("N2")</td>
                                            <td class="num">
                                                <SfNumericTextBox TValue="decimal" Value="@c.GstRate" CssClass="e-small" Format="N2" ShowSpinButton="false"
                                                                  ValueChanged="@((decimal v) => { c.GstRate = v; Recalc(); })" />
                                            </td>
                                            <td class="num">@c.GstAmount.ToString("N2")</td>
                                            <td class="num">@c.NetAmount.ToString("N2")</td>
                                            <td><SfButton OnClick="@(() => RemoveCharge(idx))" CssClass="e-small delete-btn" IconCss="e-icons e-delete" /></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7" style="text-align:right;">Totals:</td>
                                        <td class="num">@item.SubTotal.ToString("N2")</td>
                                        <td></td>
                                        <td class="num">@item.GstAmount.ToString("N2")</td>
                                        <td class="num">@item.TotalAmount.ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label class="form-Custom-label">Reference:</label>
                        <SfTextBox @bind-Value="@item.Reference" CssClass="e-small" />
                    </div>
                    <div class="mb-3 col-md-6">
                        <label class="form-Custom-label">Remarks:</label>
                        <SfTextBox @bind-Value="@item.Remarks" CssClass="e-small" />
                    </div>
                </div>

                @if (item.Status == BillStatus.Rejected && !string.IsNullOrEmpty(item.RejectionReason))
                {
                    <div class="alert alert-warning" style="padding:6px 10px;font-size:12px;margin-top:8px;">
                        <strong>Rejected:</strong> @item.RejectionReason
                        (by @item.RejectedBy on @(item.RejectedOn?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")))
                    </div>
                }

                @* ── Invoice panel — the Bill IS the invoice; issue it + attach documents ── *@
                @if (Id != 0)
                {
                    var invoiceReady = item.Status == BillStatus.Approved || item.Status == BillStatus.Closed;
                    <div class="invoice-panel">
                        <div class="invoice-hdr">
                            <span>Invoice</span>
                            <span class="inv-status inv-@item.InvoiceStatus.ToString().ToLower()">@item.InvoiceStatus</span>
                        </div>
                        <div class="invoice-body">
                            <div class="inv-grid">
                                <div class="inv-field"><span class="inv-lbl">Invoice Number</span>
                                    <span class="inv-val">@(item.InvoiceNumber ?? "— not issued —")</span></div>
                                <div class="inv-field"><span class="inv-lbl">Invoice Date</span>
                                    <span class="inv-val">@(item.InvoiceDate?.ToString("dd-MMM-yyyy") ?? "—")</span></div>
                                <div class="inv-field"><span class="inv-lbl">Due Date</span>
                                    <span class="inv-val">@(item.DueDate?.ToString("dd-MMM-yyyy") ?? "—")</span></div>
                                <div class="inv-field"><span class="inv-lbl">Payment Terms</span>
                                    <SfTextBox @bind-Value="@item.PaymentTerms" CssClass="e-small" Placeholder="e.g. 30 days" /></div>
                                <div class="inv-field inv-field-wide"><span class="inv-lbl">Invoice Remarks</span>
                                    <SfTextBox @bind-Value="@item.InvoiceRemarks" CssClass="e-small" /></div>
                            </div>

                          @if (invoiceReady)
                          {
                            <div class="inv-actions">
                                <SfButton CssClass="e-small wf-btn-submit" IconCss="e-icons e-file-document"
                                          OnClick="@GenerateInvoice">@(item.IsIssued ? "Re-issue Invoice" : "Generate Invoice")</SfButton>
                                @if (_activeInvoiceDocId is not null)
                                {
                                    <a class="e-btn e-small wf-btn-open" href="/invoices/doc/@_activeInvoiceDocId" target="_blank">
                                        <span class="e-icons e-preview"></span> Preview PDF</a>
                                    <a class="e-btn e-small wf-btn-verify" href="/invoices/doc/@_activeInvoiceDocId?dl=true">
                                        <span class="e-icons e-download"></span> Download PDF</a>
                                    <SfButton CssClass="e-small wf-btn-approve" IconCss="e-icons e-send-1" OnClick="@EmailInvoice">Email Invoice</SfButton>
                                }
                                <span class="inv-sep"></span>
                                <label class="inv-lbl mb-0">Attachment</label>
                                <SfComboBox TItem="InvoiceDocumentType" TValue="InvoiceDocumentType" DataSource="@_uploadTypes"
                                            @bind-Value="_uploadType" Width="170px" CssClass="e-small" />
                                <label class="e-btn e-small wf-btn-open" style="margin:0;cursor:pointer;">
                                    <span class="e-icons e-upload"></span> Choose file…
                                    <InputFile OnChange="OnFileSelected" style="display:none;" />
                                </label>
                                <small class="text-muted">Vendor invoice / credit / debit note</small>
                            </div>

                            @if (_documents.Count > 0)
                            {
                                <div class="charges-scroll" style="margin-top:10px;">
                                    <table class="charges-table" style="min-width:760px;">
                                        <thead>
                                            <tr>
                                                <th style="width:150px;">Type</th>
                                                <th>File</th>
                                                <th style="width:60px;" class="num">Ver</th>
                                                <th style="width:130px;">Uploaded By</th>
                                                <th style="width:150px;">Uploaded</th>
                                                <th style="width:70px;">Active</th>
                                                <th style="width:150px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var d in _documents)
                                            {
                                                <tr style="@(d.IsActive ? "" : "opacity:.55;")">
                                                    <td>@Pretty(d.DocumentType)</td>
                                                    <td>@d.OriginalFileName</td>
                                                    <td class="num">@d.Version</td>
                                                    <td>@d.UploadedBy</td>
                                                    <td>@d.UploadedDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                                                    <td>@(d.IsActive ? "Yes" : "No")</td>
                                                    <td>
                                                        <a class="e-btn e-small e-flat" href="/invoices/doc/@d.Id" target="_blank" title="View">View</a>
                                                        <a class="e-btn e-small e-flat" href="/invoices/doc/@d.Id?dl=true" title="Download">Get</a>
                                                        @if (d.IsActive)
                                                        {
                                                            <SfButton CssClass="e-small delete-btn" IconCss="e-icons e-delete"
                                                                      OnClick="@(() => DeactivateDoc(d.Id))" Title="Deactivate" />
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                          }
                          else
                          {
                            <div class="inv-actions">
                                <small class="text-muted">Invoice details are shown above. Invoice <b>generation</b> and attachments become available once this bill is <b>Approved</b>. Current status: <b>@item.Status</b>.</small>
                            </div>
                          }
                        </div>
                    </div>
                }
            </EditForm>
        </div>

        <div class="modal-footer">
            <div class="row bs" style="width:100%;">
                <div class="col-md-5">
                    <small>Created by <span class="billed-by">@item.CreatedBy</span>
                        @(item.CreatedOn != default ? "on " + item.CreatedOn.ToLocalTime().ToString("dd-MMM-yyyy HH:mm") : "")</small>
                </div>
                <div class="col-md-2 text-center">
                    @if (Id != 0 && item.Status == BillStatus.Draft)
                    {
                        @* Same circuit, same DbContext — clicking Submit mid-save would race exactly as a
                           second Update click does. *@
                        <SfButton OnClick="@Submit" CssClass="e-small wf-btn-submit" IconCss="e-icons e-send-1"
                                  Disabled="@_saving">Submit</SfButton>
                    }
                    @* Disabled while a save is in flight. A Blazor Server circuit holds ONE scoped DbContext,
                       so a second click before the first save returns runs two overlapping UpdateAsync calls
                       on it — DbContext is not thread-safe, and WorkflowOrchestrator opens its own
                       transaction, so the second one crashes. *@
                    <SfButton IsPrimary="true" OnClick="@Save" CssClass="e-small" IconCss="e-icons e-save-as"
                              Disabled="@_saving">@(_saving ? "Saving…" : btnText)</SfButton>
                    <SfButton OnClick="@Close" CssClass="e-small" IconCss="e-icons e-circle-close"
                              Disabled="@_saving">Close</SfButton>
                </div>
                <div class="col-md-5 text-end">
                    @if (item.ModifiedOn != null)
                    {
                        <small>Modified by <span class="billed-by">@item.ModifiedBy</span>
                            on @item.ModifiedOn.Value.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private IModalDialogContext? Modal { get; set; }
    [Parameter] public EventCallback LoadOnSaveReference { get; set; }
    [Parameter] public long Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public BillMode Mode { get; set; } = BillMode.Clearance;
    /// <summary>When launched from an AWB shipment / Export job to raise a Transportation bill, the source
    /// type + id are mapped into a prepared Draft bill (transport snapshot pre-filled). JobOrder sources keep
    /// using <see cref="JobOrderId"/>.</summary>
    [Parameter] public BillSourceType? SourceType { get; set; }
    [Parameter] public long SourceId { get; set; }
    /// <summary>When launched from a Job row, pre-links the new bill to that job.</summary>
    [Parameter] public long JobOrderId { get; set; }

    private Bill item = new();
    private JobOrder? _job;      // parent job for the read-only "Linked Job" panel
    private string btnText => Id == 0 ? "Save" : "Update";

    private List<DhlClient>     _clients      = new();
    private List<CompanyBranch> _branches     = new();
    private List<Currency>      _currencies   = new();
    private List<ChargeCode>    _chargeCodes  = new();
    private List<Sac>           _sacs         = new();
    private List<JobOrder>      _jobs         = new();
    private List<Transporter>   _transporters = new();

    private static readonly ChargeCategory[] _categories =
        (ChargeCategory[])Enum.GetValues(typeof(ChargeCategory));

    // Charges are grouped by their originating operation for display; lines with no operation fall
    // under the general bucket. Original list indices are preserved so inline edit/remove keep working.
    private const string GeneralGroup = "General / Unassigned";
    private IEnumerable<IGrouping<string, (BillCharge Charge, int Index)>> GroupedCharges() =>
        item.Charges
            .Select((c, i) => (Charge: c, Index: i))
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Charge.OperationName) ? GeneralGroup : x.Charge.OperationName!);

    // ── Invoice panel state ───────────────────────────────────────────────────
    private List<InvoiceDocument> _documents = new();
    private long? _activeInvoiceDocId;
    private InvoiceDocumentType _uploadType = InvoiceDocumentType.VendorInvoice;
    // Customer invoice is generated (not uploaded), so it's excluded from the upload picker.
    private static readonly InvoiceDocumentType[] _uploadTypes =
    {
        InvoiceDocumentType.VendorInvoice,
        InvoiceDocumentType.CreditNote,
        InvoiceDocumentType.DebitNote,
        InvoiceDocumentType.Other,
    };

    private static string Pretty(InvoiceDocumentType t) => t switch
    {
        InvoiceDocumentType.CustomerInvoice => "Customer Invoice",
        InvoiceDocumentType.VendorInvoice   => "Vendor Invoice",
        InvoiceDocumentType.CreditNote      => "Credit Note",
        InvoiceDocumentType.DebitNote       => "Debit Note",
        _                                   => "Other",
    };

    protected override async Task OnInitializedAsync()
    {
        _branches    = await BranchService.GetAllAsync();
        _clients     = await Logistics.GetAllClientsAsync();
        _currencies  = await CurrencyService.GetAllAsync();
        _chargeCodes = await ChargeCodeService.GetAllAsync();
        _sacs        = await SacService.GetAllAsync();
        // Approved + Closed jobs are the natural source for billing. Submit/Verify
        // happens earlier; jobs in those states aren't yet ready to bill against.
        _jobs        = await JobOrderService.GetByStatusAsync(JobOrderStatus.Approved, JobOrderStatus.Closed);
        _transporters = await TransportService.GetTransportersAsync();

        if (Id != 0)
        {
            var e = await Service.GetByIdAsync(Id);
            if (e is not null) { item = e; Recalc(); }
            // Draft-only synchronization: a job-raised Transportation bill re-inherits the job's
            // Transport-category charges every time it is (re)opened, matched by SourceJobChargeId so
            // repeated refreshes never duplicate a row. No-op for any other mode/status — from Submitted
            // onward the charges are immutable. Persists immediately, so Submit uses the synced totals.
            await TransportService.SyncDraftBillFromJobAsync(item);
            if (item.JobOrderId.HasValue)
                _job = await JobOrderService.GetByIdAsync(item.JobOrderId.Value);
            await LoadDocumentsAsync();
        }
        else if (SourceType == BillSourceType.AwbShipment)
        {
            // Launched from an AWB shipment — map its data into a prepared Transportation bill.
            item = await TransportService.PrepareFromAwbAsync(SourceId);
            Recalc();
        }
        else if (SourceType == BillSourceType.ExportJob)
        {
            // Launched from an Export job — map its data into a prepared Transportation bill.
            item = await TransportService.PrepareFromExportAsync(SourceId);
            Recalc();
        }
        else if (JobOrderId != 0)
        {
            // Launched from a Job row — prepare a bill pre-linked to (and auto-filled from) the job.
            _job = await JobOrderService.GetByIdAsync(JobOrderId);
            item = _job is not null
                ? BillService.PrepareForJob(_job, Mode)
                : new Bill { Mode = Mode, BillDate = DateTime.UtcNow.Date, ExchangeRate = 1m };
            // A job-raised Transportation bill inherits the job's Transport-category charges (only). No
            // Transportation charges on the job → the bill must not be created; close without a bill.
            if (Mode == BillMode.Transportation && _job is not null
                && !await TransportService.PopulateJobChargesAsync(item))
            {
                Toast(TransportationBillService.NoTransportChargesMessage);
                _abortOpen = true;
            }
            Recalc();
        }
        else
        {
            item = new Bill { Mode = Mode, BillDate = DateTime.UtcNow.Date, ExchangeRate = 1m };
        }
    }

    /// <summary>
    /// When a job is chosen, link it and pull header fields (Customer / Branch / Currency)
    /// off the job. Shipper / Consignee / Commodity / Port etc. stay on the job and show
    /// read-only in the Linked Job panel — never copied onto the bill.
    /// </summary>
    private async Task OnJobPicked(long? jobId)
    {
        item.JobOrderId = jobId;
        if (jobId.HasValue)
        {
            _job = _jobs.FirstOrDefault(j => j.Id == jobId) ?? await JobOrderService.GetByIdAsync(jobId.Value);
            if (_job is not null)
            {
                item.BranchId        = _job.BranchId;
                item.BillingClientId = _job.BillingClientId;
                item.CustomerInvoiceNumber = _job.CustomerInvoiceNumber;   // carry the customer's invoice ref
                if (_job.CurrencyId.HasValue) item.CurrencyId = _job.CurrencyId;

                // Linking a job to a Draft Transportation bill inherits the job's Transport-category
                // charges (idempotent by SourceJobChargeId). None on the job → the link can't produce a
                // billable TB bill; warn now — the workflow guard will refuse the save regardless.
                if (item.Mode == BillMode.Transportation && item.Status == BillStatus.Draft)
                {
                    item.Charges.RemoveAll(c => c.SourceJobChargeId.HasValue);   // drop the OLD job's lines
                    if (!await TransportService.PopulateJobChargesAsync(item))
                        Toast(TransportationBillService.NoTransportChargesMessage);
                    Recalc();
                }
            }
        }
        else
        {
            // Un-linked from the job: drop the inherited reference too, or the bill would keep the old job's
            // Customer Invoice No and stay in that job's Billing Group (and be pulled into its consolidated
            // invoice). BillWorkflowHandler enforces the same rule on save; this just keeps the field honest
            // on screen. A user-entered reference on a genuinely standalone bill can still be typed back in.
            item.CustomerInvoiceNumber = null;
            // Charges inherited from the job leave with it — they belong to the job's transport leg,
            // not to a standalone bill. Manually keyed lines stay.
            if (item.Charges.RemoveAll(c => c.SourceJobChargeId.HasValue) > 0) Recalc();
            _job = null;
        }
    }

    private void AddCharge()
    {
        item.Charges.Add(new BillCharge { Quantity = 1m, DisplayOrder = item.Charges.Count + 1 });
        Recalc();
    }

    private void RemoveCharge(int idx)
    {
        if (idx < 0 || idx >= item.Charges.Count) return;
        item.Charges.RemoveAt(idx);
        Recalc();
    }

    private void OnChargeCodePicked(int idx, int? chargeCodeId)
    {
        if (idx < 0 || idx >= item.Charges.Count) return;
        var c = item.Charges[idx];
        c.ChargeCodeId = chargeCodeId;
        if (chargeCodeId.HasValue)
        {
            var cc = _chargeCodes.FirstOrDefault(x => x.Id == chargeCodeId);
            if (cc is not null)
            {
                if (string.IsNullOrWhiteSpace(c.Description)) c.Description = cc.ChargeName;
                if (c.Rate == 0 && cc.DefaultAmount > 0)      c.Rate = cc.DefaultAmount;
                if (cc.SacId.HasValue)                         c.SacId = cc.SacId;
                if (c.GstRate == 0 && cc.Sac is not null)      c.GstRate = cc.Sac.GstRate;
            }
        }
        Recalc();
    }

    private void Recalc() => BillService.RecalcTotals(item);

    /// <summary>Set during init when the popup must not open at all (e.g. raising a Transportation bill
    /// from a job that has no Transportation charges). The modal can only be dismissed once rendered,
    /// so the toast fires in init and the close happens on first render.</summary>
    private bool _abortOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _abortOpen)
        {
            await Task.Yield();                      // let the first render (and the toast) land
            Modal?.Close(ModalResult.Cancel());
        }
    }

    /// <summary>True while a save is in flight — see <see cref="Save"/>.</summary>
    private bool _saving;

    /// <summary>
    /// Saves the bill. Re-entrant clicks are refused.
    ///
    /// <para><b>Why the guard.</b> A Blazor Server circuit holds ONE scoped AppDbContext for its whole life,
    /// and the modal only closes AFTER the save completes. Without this, a second click while the first save
    /// was still running started a second <c>UpdateAsync</c> on that same DbContext — which is not
    /// thread-safe, and whose orchestrator opens its own transaction. The result was a crash whose message
    /// varied with the timing ("A second operation was started on this context instance…" or "The connection
    /// is already in a transaction…"), landing on whichever await touched the context first.</para>
    ///
    /// <para>The flag — not the button's Disabled state — is the real defence: two clicks can be queued
    /// before the re-render that disables the button ever reaches the browser.</para>
    /// </summary>
    private async Task Save()
    {
        if (_saving) return;               // a save is already running — ignore the click

        if (item.BillingClientId == 0) { Toast("Billing Client is required."); return; }
        if (item.Charges.Count == 0)   { Toast("At least one charge is required."); return; }

        _saving = true;
        try
        {
            if (Id == 0)
            {
                item.Mode = Mode;
                await Service.CreateAsync(item);
            }
            else
            {
                await Service.UpdateAsync(item);
            }
            ToastService.Show(new() { Title = "Success!", Content = "Bill saved.", CssClass = "e-toast-success" });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
            this.Modal?.Close(ModalResult.OK());

            // NOTE: _saving is deliberately NOT cleared on success. Blazor Server dispatches circuit events
            // one at a time, so a click queued behind this save is delivered only AFTER it returns — by which
            // point clearing the flag would let it save a second time and write a duplicate timeline/audit
            // row. The popup is closing, so leaving the flag set simply makes those queued clicks no-ops.
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });

            // Cleared only on FAILURE — the popup stays open and the user must be able to correct and retry.
            _saving = false;
        }
    }

    private async Task Submit()
    {
        try
        {
            await Service.SubmitAsync(Id);
            ToastService.Show(new() { Title = "Submitted", Content = "Bill sent for verification.", CssClass = "e-toast-success" });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
            this.Modal?.Close(ModalResult.OK());
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    // ── Invoice actions ───────────────────────────────────────────────────────
    private async Task LoadDocumentsAsync()
    {
        if (item.Id == 0) { _documents = new(); _activeInvoiceDocId = null; return; }
        _documents = await InvoiceService.GetDocumentsAsync(item.Id);
        _activeInvoiceDocId = _documents
            .Where(d => d.DocumentType == InvoiceDocumentType.CustomerInvoice && d.IsActive)
            .Select(d => (long?)d.Id).FirstOrDefault();
    }

    private async Task GenerateInvoice()
    {
        try
        {
            await InvoiceService.IssueInvoiceAsync(item.Id, item.PaymentTerms, item.InvoiceRemarks);
            await LoadDocumentsAsync();
            StateHasChanged();   // immediately reflect Invoice No / Date / Status / Preview / Download
            ToastService.Show(new() { Title = "Invoice issued", Content = $"Invoice {item.InvoiceNumber} generated.", CssClass = "e-toast-success" });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var f = e.File;
            await using var stream = f.OpenReadStream(25 * 1024 * 1024); // 25 MB cap
            await InvoiceService.UploadDocumentAsync(item.Id, stream, f.Name, f.ContentType, _uploadType);
            await LoadDocumentsAsync();
            ToastService.Show(new() { Title = "Uploaded", Content = $"{Pretty(_uploadType)} attached.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Error!", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    private async Task DeactivateDoc(long docId)
    {
        await InvoiceService.DeactivateDocumentAsync(docId);
        await LoadDocumentsAsync();
    }

    // Placeholder — outbound invoice email is not yet wired (MailKit is used only for
    // inbound IMAP polling). Surfaces intent without touching email/accounting logic.
    private void EmailInvoice()
    {
        var to = item.BillingClient?.ContactEmail;
        ToastService.Show(new()
        {
            Title = "Email Invoice",
            Content = string.IsNullOrWhiteSpace(to)
                ? "Email integration is not yet available. (No customer email on file.)"
                : $"Email integration is not yet available. Invoice {item.InvoiceNumber} would be sent to {to}.",
            CssClass = "e-toast-info"
        });
    }

    private void Toast(string msg) =>
        ToastService.Show(new() { Title = "Validation", Content = msg, CssClass = "e-toast-danger" });

    private void Close() => this.Modal?.Close(ModalResult.Cancel());
}
