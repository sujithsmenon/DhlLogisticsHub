@inject CustomerInvoiceService InvoiceSvc
@inject BillingGroupService GroupSvc
@inject DuplicateBillingService DuplicateSvc
@inject InvoiceService PdfSvc
@inject IJSRuntime JS
@inject IToastService ToastService

@*
    Generate Customer Invoice — selection popup over a Billing Group.

    Lists ONLY Bills; selection happens only at Bill level. Jobs appear inside an expanded bill card as a
    READ-ONLY preview (no checkbox), because invoices are raised from Bills, never from Jobs.

    The candidate list comes from CustomerInvoiceService.GetSelectableBillsAsync, which is keyed on the
    group's CustomerInvoiceNumber — so bills from a different reference are structurally unable to appear
    here. Job previews are lazy-loaded on expand, so a large group stays fast.
*@

<style>
    .gci-hdr      { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px 16px;
                    padding:10px 12px; border:1px solid var(--border); border-radius:8px; background:var(--surface2); margin-bottom:12px; }
    .gci-hdr .k   { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); }
    .gci-hdr .v   { font-size:13px; font-weight:700; color:var(--text); }
    .gci-sec      { font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.04em;
                    color:var(--muted); margin:14px 0 6px; }
    .gci-card     { border:1px solid var(--border); border-radius:8px; margin-bottom:8px; background:var(--card); }
    .gci-card.sel { border-color:#0868B2; box-shadow:0 0 0 1px #0868B2 inset; }
    .gci-row      { display:flex; align-items:center; gap:10px; padding:8px 10px; cursor:pointer; }
    .gci-row:hover{ background:var(--surface2); }
    .gci-no       { font-weight:800; font-size:12.5px; min-width:130px; }
    .gci-meta     { font-size:11.5px; color:var(--muted); }
    .gci-amt      { margin-left:auto; text-align:right; white-space:nowrap; }
    .gci-amt .t   { font-weight:800; font-size:13px; }
    .gci-amt .s   { font-size:11px; color:var(--muted); }
    .gci-caret    { font-size:11px; color:var(--muted); width:14px; }
    .gci-detail   { border-top:1px dashed var(--border); padding:10px 12px; background:var(--surface2); }
    .gci-jobgrid  { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:6px 14px; }
    .gci-jobgrid .k { font-size:10px; font-weight:700; text-transform:uppercase; color:var(--muted); }
    .gci-jobgrid .v { font-size:12px; font-weight:600; }
    .gci-ro       { font-size:10.5px; font-weight:700; color:#9a7100; background:#fff2cc;
                    padding:1px 7px; border-radius:9px; display:inline-block; margin-bottom:6px; }
    .gci-sum      { border:1px solid var(--border); border-radius:8px; padding:10px 12px; background:var(--card); }
    .gci-sum .r   { display:flex; justify-content:space-between; font-size:12px; padding:2px 0; }
    .gci-sum .r.total { border-top:1px solid var(--border); margin-top:5px; padding-top:6px; font-weight:800; font-size:14px; }
    .gci-empty    { padding:18px; text-align:center; color:var(--muted); font-size:12.5px;
                    border:1px dashed var(--border); border-radius:8px; }
    .gci-st       { font-size:10.5px; font-weight:700; padding:1px 8px; border-radius:9px; background:#e9edf3; color:#475569; }

    /* Duplicate highlighting — amber = potential duplicate billing, blue = expected (different bill types) */
    .gci-card.warn { border-color:#D97706; box-shadow:0 0 0 1px #D97706 inset; }
    .gci-card.info { border-color:#2563EB; }
    .gci-flag      { display:flex; align-items:center; gap:6px; font-size:11px; font-weight:700;
                     padding:4px 10px; border-top:1px dashed var(--border); }
    .gci-flag.warn { color:#92400E; background:#FEF3C7; }
    .gci-flag.info { color:#1E40AF; background:#DBEAFE; }
    .gci-dupjob    { outline:2px solid #D97706; outline-offset:2px; border-radius:5px; }

    /* Warning dialog — an in-popup overlay (a nested modal inside a modal is fragile) */
    .gci-ovl      { position:absolute; inset:0; background:rgba(15,23,42,.45); z-index:20;
                    display:flex; align-items:center; justify-content:center; padding:16px; }
    .gci-dlg      { background:var(--card); border-radius:10px; max-width:820px; width:100%;
                    max-height:88%; overflow:auto; box-shadow:0 12px 40px rgba(0,0,0,.3); }
    .gci-dlg-hd   { padding:12px 16px; border-bottom:1px solid var(--border); font-weight:800; font-size:15px;
                    display:flex; align-items:center; gap:8px; }
    .gci-dlg-bd   { padding:12px 16px; }
    .gci-dlg-ft   { padding:10px 16px; border-top:1px solid var(--border); display:flex; gap:8px; justify-content:flex-end; }
    .gci-dtbl     { width:100%; border-collapse:collapse; font-size:12px; }
    .gci-dtbl th  { text-align:left; font-size:10px; text-transform:uppercase; color:var(--muted);
                    border-bottom:1px solid var(--border); padding:5px 6px; }
    .gci-dtbl td  { padding:5px 6px; border-bottom:1px solid var(--border); vertical-align:top; }
    .gci-sev      { font-size:10px; font-weight:800; padding:1px 8px; border-radius:9px; white-space:nowrap; }
    .gci-sev.warn { background:#FEF3C7; color:#92400E; }
    .gci-sev.info { background:#DBEAFE; color:#1E40AF; }
    .gci-dupsum   { display:flex; flex-wrap:wrap; gap:14px; padding:8px 10px; border:1px solid var(--border);
                    border-radius:8px; background:var(--surface2); margin-bottom:10px; font-size:12px; }
    .gci-dupsum b { display:block; font-size:15px; }

    @@media (max-width: 768px) {
        .gci-row  { flex-wrap:wrap; }
        .gci-amt  { margin-left:0; width:100%; text-align:left; }
        .gci-dtbl, .gci-dtbl tbody, .gci-dtbl tr, .gci-dtbl td { display:block; width:100%; }
        .gci-dtbl thead { display:none; }
    }
</style>

<div class="modal-header">
    <h5 class="modal-title">Generate Customer Invoice</h5>
    <button type="button" class="btn-close e-small" @onclick="Close" aria-label="Close"></button>
</div>

<div class="modal-body" style="position:relative;">

    @* ── Duplicate Billing Warning dialog ────────────────────────────────────
       Advisory: it NEVER blocks generation and never touches a bill. Default action is
       Review Selection; Generate Anyway proceeds with the user's selection verbatim and
       writes an audit entry. *@
    @if (_showDupDialog && _dup is not null)
    {
        <div class="gci-ovl">
            <div class="gci-dlg">
                <div class="gci-dlg-hd">
                    <span>@(_dup.HasWarnings ? "⚠️" : "ℹ️")</span>
                    <span>Duplicate Billing @(_dup.HasWarnings ? "Warning" : "Information")</span>
                </div>
                <div class="gci-dlg-bd">
                    <div class="gci-dupsum">
                        <div>Expected Duplicates<b>@_dup.ExpectedCount</b></div>
                        <div>Potential Duplicate Bills<b>@_dup.PotentialDuplicateBills</b></div>
                        <div>Potential Duplicate Amount<b>@_dup.PotentialDuplicateAmount.ToString("N2")</b></div>
                    </div>

                    <p style="font-size:12px;color:var(--muted);margin-bottom:8px;">
                        The following operational records appear in more than one selected bill.
                        @if (!_dup.HasWarnings)
                        {
                            <span>All of them are <strong>expected</strong> — the same record billed once per bill
                            type is normal, because different bill types bill different charges.</span>
                        }
                    </p>

                    <table class="gci-dtbl">
                        <thead>
                            <tr>
                                <th>Operational Record</th>
                                <th>Appears In</th>
                                <th>Amount</th>
                                <th>Reason</th>
                                <th>Severity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _dup.Findings)
                            {
                                var warn = f.Severity >= DuplicateSeverity.Warning;
                                <tr>
                                    <td>
                                        <strong>@f.SourceKey</strong><br />
                                        <span class="gci-meta">@f.RecordLabel</span>
                                    </td>
                                    <td>
                                        @foreach (var o in f.Occurrences)
                                        {
                                            <div>@o.BillType — <strong>@o.BillNo</strong></div>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var o in f.Occurrences)
                                        {
                                            <div>@o.Amount.ToString("N2")</div>
                                        }
                                        @if (warn)
                                        {
                                            <div style="color:#92400E;font-weight:700;margin-top:3px;">
                                                at risk: @f.PotentialDuplicateAmount.ToString("N2")
                                            </div>
                                        }
                                    </td>
                                    <td class="gci-meta">@f.Reason</td>
                                    <td>
                                        <span class="gci-sev @(warn ? "warn" : "info")">
                                            @(warn ? "⚠️ Warning" : "ℹ️ Information")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="gci-dlg-ft">
                    <SfButton OnClick="@CancelFromDialog" CssClass="e-small">Cancel</SfButton>
                    <SfButton OnClick="@GenerateAnyway" CssClass="e-small" Disabled="@_busy">Generate Anyway</SfButton>
                    @* Default action, per spec — primary styling. *@
                    <SfButton IsPrimary="true" OnClick="@ReviewSelection" CssClass="e-small">Review Selection</SfButton>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <SfSpinner Visible="true" Label="Loading billing group..." />
    }
    else
    {
        <!-- Group header -->
        <div class="gci-hdr">
            <div><div class="k">Customer Invoice No.</div><div class="v">@CustomerInvoiceNumber</div></div>
            <div><div class="k">Client</div><div class="v">@(_client ?? "—")</div></div>
            <div><div class="k">Branch</div><div class="v">@(_branch ?? "—")</div></div>
            <div><div class="k">Currency</div><div class="v">@(_currency ?? "—")</div></div>
            <div><div class="k">Selected Bills</div><div class="v">@SelectedCount of @_all.Count</div></div>
            <div><div class="k">Selected Amount</div><div class="v">@SelectedTotal.ToString("N2")</div></div>
        </div>

        @if (_all.Count == 0)
        {
            <div class="gci-empty">
                No invoiceable bills in this billing group.<br />
                Bills must be <strong>Approved</strong> and not already on a customer invoice.
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-8">
                    <!-- Actions -->
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
                        <SfButton OnClick="SelectAll"  CssClass="e-small" IconCss="e-icons e-check-box">Select All Bills</SfButton>
                        <SfButton OnClick="ClearAll"   CssClass="e-small" IconCss="e-icons e-uncheck-box">Clear All Bills</SfButton>
                        <SfButton OnClick="ExpandAll"  CssClass="e-small" IconCss="e-icons e-chevron-down">Expand All</SfButton>
                        <SfButton OnClick="CollapseAll" CssClass="e-small" IconCss="e-icons e-chevron-up">Collapse All</SfButton>
                    </div>

                    @* Section 1 — Clearance & Forwarding *@
                    <div class="gci-sec">Clearance &amp; Forwarding Bills (@_cf.Count)</div>
                    @if (_cf.Count == 0)
                    {
                        <div class="gci-empty">None in this group.</div>
                    }
                    @foreach (var b in _cf) { @BillCard(b) }

                    @* Section 2 — Transportation *@
                    <div class="gci-sec">Transportation Bills (@_tb.Count)</div>
                    @if (_tb.Count == 0)
                    {
                        <div class="gci-empty">None in this group.</div>
                    }
                    @foreach (var b in _tb) { @BillCard(b) }
                </div>

                <!-- Live summary -->
                <div class="col-md-4">
                    <div class="gci-sum">
                        <div class="gci-sec" style="margin-top:0;">Summary</div>
                        <div class="r"><span>Customer Invoice No.</span><strong>@CustomerInvoiceNumber</strong></div>
                        <div class="r"><span>Selected Clearance Bills</span><strong>@SelectedCf</strong></div>
                        <div class="r"><span>Selected Transportation Bills</span><strong>@SelectedTb</strong></div>
                        <div class="r"><span>Selected Jobs</span><strong>@SelectedJobs</strong></div>
                        <div class="r"><span>Subtotal</span><strong>@SelectedSubTotal.ToString("N2")</strong></div>
                        <div class="r"><span>GST</span><strong>@SelectedGst.ToString("N2")</strong></div>
                        <div class="r total"><span>Grand Total</span><span>@SelectedTotal.ToString("N2")</span></div>

                        @* Duplicate summary — live, recomputed whenever the selection changes. *@
                        @if (_dup is not null && _dup.HasFindings)
                        {
                            <div class="gci-sec" style="margin-top:12px;">Duplicate Records</div>
                            <div class="r">
                                <span>ℹ️ Expected Duplicates</span><strong>@_dup.ExpectedCount</strong>
                            </div>
                            <div class="r">
                                <span>⚠️ Potential Duplicate Bills</span><strong>@_dup.PotentialDuplicateBills</strong>
                            </div>
                            <div class="r">
                                <span>Potential Duplicate Amount</span>
                                <strong>@_dup.PotentialDuplicateAmount.ToString("N2")</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="modal-footer">
    <SfButton OnClick="@Close" CssClass="e-small" IconCss="e-icons e-circle-close">Cancel</SfButton>
    @* Preview builds the consolidated PDF from the selection WITHOUT persisting anything — no CI number is
       consumed and no bill is touched until the user actually generates. *@
    <SfButton OnClick="@Preview" CssClass="e-small" IconCss="e-icons e-print"
              Disabled="@(SelectedCount == 0 || _busy)">
        Preview Invoice
    </SfButton>
    <SfButton IsPrimary="true" OnClick="@Generate" CssClass="e-small" IconCss="e-icons e-save-as"
              Disabled="@(SelectedCount == 0 || _busy)">
        Generate Invoice (@SelectedCount)
    </SfButton>
</div>

@code {
    [CascadingParameter] private IModalDialogContext? Modal { get; set; }

    /// <summary>The Billing Group key. Only bills carrying THIS reference can ever be listed.</summary>
    [Parameter] public string CustomerInvoiceNumber { get; set; } = string.Empty;

    /// <summary>The bill the user launched from — pre-selected, per spec.</summary>
    [Parameter] public long CurrentBillId { get; set; }

    [Parameter] public EventCallback LoadOnSaveReference { get; set; }

    private bool _loading = true, _busy, _showDupDialog;
    private DuplicateReport? _dup;                       // advisory — recomputed on every selection change
    private List<Bill> _all = new(), _cf = new(), _tb = new();
    private readonly HashSet<long> _selected = new();
    private readonly HashSet<long> _expanded = new();
    private readonly Dictionary<long, BillSourceDetail> _sources = new();   // lazy — filled on expand

    private string? _client, _branch, _currency;

    // ── Live summary (recomputed from the selection, never cached) ────────────
    private IEnumerable<Bill> Sel        => _all.Where(b => _selected.Contains(b.Id));
    private int      SelectedCount       => _selected.Count;
    private int      SelectedCf          => _cf.Count(b => _selected.Contains(b.Id));
    private int      SelectedTb          => _tb.Count(b => _selected.Contains(b.Id));
    private decimal  SelectedSubTotal    => Sel.Sum(b => b.SubTotal);
    private decimal  SelectedGst         => Sel.Sum(b => b.GstAmount);
    private decimal  SelectedTotal       => Sel.Sum(b => b.TotalAmount);

    /// <summary>Distinct originating records behind the selected bills — two bills off the same job count once.
    /// Only counts sources already loaded (expanded); falls back to the bills' own source columns otherwise.</summary>
    private int SelectedJobs => Sel
        .Select(b => _sources.TryGetValue(b.Id, out var s) ? s.SourceKey : SourceKeyOf(b))
        .Where(k => k is not null)
        .Distinct()
        .Count();

    private static string? SourceKeyOf(Bill b) =>
        b.JobOrderId is { } j ? $"JOB:{j}"
        : b.SourceType == BillSourceType.AwbShipment && b.SourceId is { } a ? $"AWB:{a}"
        : b.SourceType == BillSourceType.ExportJob   && b.SourceId is { } e ? $"EXP:{e}"
        : null;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _all = await InvoiceSvc.GetSelectableBillsAsync(CustomerInvoiceNumber);
            _cf  = _all.Where(b => b.Mode != BillMode.Transportation).ToList();
            _tb  = _all.Where(b => b.Mode == BillMode.Transportation).ToList();

            var first = _all.FirstOrDefault();
            _client   = first?.BillingClient?.CompanyName;
            _branch   = first?.Branch?.BranchName;
            _currency = first?.Currency?.CurrencyCode ?? first?.Currency?.CurrencyName;

            // The bill the user came from starts selected.
            if (CurrentBillId != 0 && _all.Any(b => b.Id == CurrentBillId))
                _selected.Add(CurrentBillId);

            await AnalyseAsync();
        }
        finally { _loading = false; }
    }

    // ── Selection (Bill level only — Jobs are never selectable) ───────────────
    private async Task Toggle(long billId)
    {
        if (!_selected.Remove(billId)) _selected.Add(billId);
        await AnalyseAsync();
    }

    private async Task SelectAll()
    {
        foreach (var b in _all) _selected.Add(b.Id);
        await AnalyseAsync();
    }

    private async Task ClearAll()
    {
        _selected.Clear();
        await AnalyseAsync();
    }

    /// <summary>Re-runs duplicate detection for the CURRENT selection. Advisory only — it never changes the
    /// selection, and never touches a bill.</summary>
    private async Task AnalyseAsync() => _dup = await DuplicateSvc.AnalyseAsync(_selected.ToList());

    private async Task ExpandAll()
    {
        foreach (var b in _all) await Expand(b.Id, true);
    }
    private void CollapseAll() => _expanded.Clear();

    /// <summary>Expanding lazy-loads the bill's originating record — a group with many bills costs nothing
    /// until the user actually opens a card.</summary>
    private async Task Expand(long billId, bool force = false)
    {
        if (!force && _expanded.Contains(billId)) { _expanded.Remove(billId); return; }
        _expanded.Add(billId);
        if (!_sources.ContainsKey(billId))
            _sources[billId] = await GroupSvc.GetBillSourceAsync(billId);
    }

    // ── Generate (duplicate check gates the FIRST attempt, never blocks) ──────

    /// <summary>Clicking Generate runs duplicate detection. Findings raise the advisory dialog; the user then
    /// chooses. With no findings we go straight through — no needless interruption.</summary>
    private async Task Generate()
    {
        if (_selected.Count == 0) return;

        await AnalyseAsync();
        if (_dup is not null && _dup.HasFindings)
        {
            _showDupDialog = true;      // Review Selection is the default action inside the dialog
            return;
        }
        await DoGenerateAsync(overrodeWarning: false);
    }

    /// <summary>"Review Selection" — back to the bill list with the offending bills highlighted. Nothing
    /// generated, nothing changed.</summary>
    private void ReviewSelection() => _showDupDialog = false;

    /// <summary>"Cancel" from the dialog — abandons the whole popup.</summary>
    private void CancelFromDialog()
    {
        _showDupDialog = false;
        Close();
    }

    /// <summary>"Generate Anyway" — the user's selection is authoritative. We generate EXACTLY what was
    /// selected (no bill is removed or altered) and record an audit entry.</summary>
    private async Task GenerateAnyway()
    {
        _showDupDialog = false;
        await DoGenerateAsync(overrodeWarning: true);
    }

    /// <summary>Builds the consolidated PDF from the current selection and opens it — persists NOTHING.</summary>
    private async Task Preview()
    {
        if (_selected.Count == 0) return;
        _busy = true;
        try
        {
            var bytes = await PdfSvc.BuildConsolidatedPreviewAsync(_selected.ToList());
            await JS.InvokeVoidAsync("dhlOpenPdf", Convert.ToBase64String(bytes),
                                     $"Preview-{CustomerInvoiceNumber}.pdf");
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Preview failed", Content = ex.Message, CssClass = "e-toast-danger" });
        }
        finally { _busy = false; }
    }

    private async Task DoGenerateAsync(bool overrodeWarning)
    {
        _busy = true;
        try
        {
            var billIds = _selected.ToList();
            var invoice = await InvoiceSvc.GenerateAsync(billIds);

            // The consolidated PDF. Generation creates NO accounting entries — A/R was posted per bill at
            // approval; this only draws a document.
            await PdfSvc.IssueConsolidatedAsync(invoice.Id);

            // Audit the override AFTER the invoice exists, so the entry can name it.
            if (overrodeWarning && _dup is not null)
                await DuplicateSvc.LogOverrideAsync(invoice, _dup, billIds);

            ToastService.Show(new()
            {
                Title = "Invoice generated",
                Content = $"Customer invoice {invoice.InvoiceNo} raised over {billIds.Count} bill(s)."
                        + (overrodeWarning && _dup!.HasWarnings
                            ? $" Duplicate warning overridden ({_dup.WarningCount}) — audit entry recorded."
                            : ""),
                CssClass = "e-toast-success",
            });
            if (LoadOnSaveReference.HasDelegate) await LoadOnSaveReference.InvokeAsync();
            Modal?.Close(ModalResult.OK());
        }
        catch (Exception ex)
        {
            ToastService.Show(new() { Title = "Cannot generate", Content = ex.Message, CssClass = "e-toast-danger" });
        }
        finally { _busy = false; }
    }

    private void Close() => this.Modal?.Close(ModalResult.Cancel());

    // ── Bill card (checkbox + summary row, expandable read-only job preview) ──
    private RenderFragment BillCard(Bill b) => __builder =>
    {
        var isSel  = _selected.Contains(b.Id);
        var isExp  = _expanded.Contains(b.Id);
        var isWarn = _dup?.WarningBillIds.Contains(b.Id) == true;   // amber — potential duplicate billing
        var isInfo = _dup?.InfoBillIds.Contains(b.Id) == true;      // blue  — expected (different bill types)

        <div class="gci-card @(isSel ? "sel" : "") @(isWarn ? "warn" : isInfo ? "info" : "")">
            <div class="gci-row" @onclick="() => Expand(b.Id)">
                @* stopPropagation: ticking the box must not also expand the card *@
                <input type="checkbox" checked="@isSel"
                       @onclick:stopPropagation="true"
                       @onchange="() => Toggle(b.Id)" />
                <span class="gci-caret">@(isExp ? "▾" : "▸")</span>
                @if (isWarn) { <span title="Contains duplicate operational records.">⚠️</span> }
                else if (isInfo) { <span title="Shares an operational record with another bill type (expected).">ℹ️</span> }
                <span class="gci-no">@b.BillNo</span>
                <span class="gci-meta">
                    @b.BillDate.ToString("dd-MMM-yyyy") &nbsp;·&nbsp; @b.Mode
                    &nbsp;·&nbsp; @(b.BillingClient?.CompanyName ?? "—")
                    &nbsp;·&nbsp; @(b.Branch?.BranchName ?? "—")
                </span>
                <span class="gci-st">@b.Status</span>
                <span class="gci-amt">
                    <div class="t">@b.TotalAmount.ToString("N2")</div>
                    <div class="s">Amt @b.SubTotal.ToString("N2") · GST @b.GstAmount.ToString("N2")</div>
                </span>
            </div>

            @* Flag banner — states plainly why the card is highlighted. *@
            @if (isWarn)
            {
                <div class="gci-flag warn">⚠️ Contains duplicate operational records.</div>
            }
            else if (isInfo)
            {
                <div class="gci-flag info">ℹ️ Shares an operational record with another bill type — expected.</div>
            }

            @if (isExp)
            {
                <div class="gci-detail">
                    <div class="gci-ro">READ ONLY — selection happens at bill level</div>
                    @if (_sources.TryGetValue(b.Id, out var s))
                    {
                        @if (s.SourceKey is null)
                        {
                            <div class="gci-meta">Standalone bill — no originating operational record.</div>
                        }
                        else
                        {
                            @* Expanding a flagged bill highlights the duplicated record itself. *@
                            var dupFinding = _dup?.Findings.FirstOrDefault(f => f.SourceKey == s.SourceKey);
                            var jobWarn    = dupFinding?.Severity >= DuplicateSeverity.Warning;

                            @if (dupFinding is not null)
                            {
                                <div class="gci-flag @(jobWarn ? "warn" : "info")" style="border-top:none;margin-bottom:6px;border-radius:5px;">
                                    @(jobWarn ? "⚠️" : "ℹ️") @s.SourceKey — @dupFinding.Reason
                                </div>
                            }

                            <div class="gci-jobgrid @(dupFinding is not null && jobWarn ? "gci-dupjob" : "")">
                                @Cell("Record", $"{s.Kind} {s.Number}")
                                @Cell("Job Type", s.JobType)
                                @Cell("Shipment Type", s.ShipmentType)
                                @Cell("Shipper", s.Shipper)
                                @Cell("Consignee", s.Consignee)
                                @Cell("HAWB / MAWB", s.AwbOrBl)
                                @Cell("Container No", s.ContainerNo)
                                @Cell("Vehicle No", s.VehicleNo)
                                @Cell("Origin", s.Origin)
                                @Cell("Destination", s.Destination)
                                @Cell("Weight (kg)", s.WeightKg?.ToString("N2"))
                                @Cell("Packages", s.Packages?.ToString("N0"))
                                @Cell("Remarks", s.Remarks)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="gci-meta">Loading…</div>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment Cell(string label, string? value) => __builder =>
    {
        <div>
            <div class="k">@label</div>
            <div class="v">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div>
        </div>
    };
}
