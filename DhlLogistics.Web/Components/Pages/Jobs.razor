@page "/jobs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using JobOrderPages = DhlLogistics.Web.Components.Pages.JobOrder
@using JobOrderModel = DhlLogistics.Shared.Models.JobOrder
@inject JobOrderService JobService
@inject BillService BillService

@*
    Operations → Jobs — master job dashboard over the ERP JobOrder entity
    (all modes: Clearance + Forwarding; Import/Export via ShipmentType).
    NOTE: this page previously bound to the legacy PickupJob entity (LogisticsService),
    which has no rows in the ERP, so it always showed "no jobs". It now reads JobOrder.
*@

<div class="page-hdr">
    <div>
        <h1>Jobs</h1>
        <div class="sub">@_all.Count job(s) &nbsp;·&nbsp; @_filtered.Count shown</div>
    </div>
</div>

<!-- Category filter bar -->
<div class="filter-bar">
    @foreach (var f in _categories)
    {
        <button class="filter-btn @(_activeCategory == f ? "active" : "")"
                @onclick="() => SetCategory(f)">@f</button>
    }
    <div class="ms-auto d-flex align-items-center gap-2">
        <label class="form-Custom-label mb-0">Status:</label>
        <SfDropDownList TItem="StatusFilter" TValue="string" DataSource="@_statuses" Width="150px" CssClass="e-small"
                        @bind-Value="_activeStatus">
            <DropDownListFieldSettings Text="Label" Value="Value" />
            <DropDownListEvents TItem="StatusFilter" TValue="string" ValueChange="@(_ => ApplyFilter())" />
        </SfDropDownList>
        <SfButton OnClick="@Reload" CssClass="e-small" IconCss="e-icons e-refresh" IsPrimary="true">Refresh</SfButton>
    </div>
</div>

<SfSpinner @bind-Visible="@_loading" Label="Loading jobs..." />

<div class="card">
    <div class="card-body">
        <SfGrid TValue="JobRow" DataSource="@_filtered" @ref="_grid" AllowPaging="true" AllowSorting="true"
                AllowResizing="true" AllowReordering="true" CssClass="e-small" ShowColumnChooser="true"
                Toolbar="@(new List<string>{ "Search", "ColumnChooser" })" Height="calc(100vh - 260px)" RowHeight="26" Width="100%">
            <GridPageSettings PageSize="20" PageSizes="@(new[] { "All", "10", "20", "50" })" />
            <GridEvents CommandClicked="OnOpen" TValue="JobRow" />
            <GridColumns>
                <GridColumn HeaderText="Open" Width="70" TextAlign="TextAlign.Center" AllowReordering="false" AllowResizing="false">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.None"
                                           ButtonOption="@(new() { Content = "Open", IconCss = "e-icons e-eye", CssClass = "wf-btn-open" })" />
                    </GridCommandColumns>
                </GridColumn>
                <GridColumn Field="@nameof(JobRow.JobNo)"       HeaderText="Job No"        Width="140" />
                <GridColumn Field="@nameof(JobRow.JobType)"     HeaderText="Job Type"      Width="90"  />
                <GridColumn Field="@nameof(JobRow.Mode)"        HeaderText="Mode"          Width="110" />
                <GridColumn Field="@nameof(JobRow.Branch)"      HeaderText="Branch"        Width="140" />
                <GridColumn Field="@nameof(JobRow.Customer)"    HeaderText="Customer"      Width="220" />
                <GridColumn Field="@nameof(JobRow.Status)"      HeaderText="Status"        Width="110" />
                <GridColumn Field="@nameof(JobRow.Verification)" HeaderText="Verification" Width="120" />
                <GridColumn Field="@nameof(JobRow.Approval)"    HeaderText="Approval"      Width="110" />
                <GridColumn Field="@nameof(JobRow.BillStatus)"  HeaderText="Bill Status"   Width="130" />
                <GridColumn Field="@nameof(JobRow.CreatedDate)" HeaderText="Created"       Width="110" Format="dd-MMM-yyyy" Type="ColumnType.Date" />
                <!-- Cargo Totals — optional columns (hidden by default; toggle via Column Chooser) -->
                <GridColumn Field="@nameof(JobRow.GrossWeightKg)"  HeaderText="Gross Wt (kg)" Width="120" Format="N3" TextAlign="TextAlign.Right" Visible="false" />
                <GridColumn Field="@nameof(JobRow.VolumeCbm)"      HeaderText="Volume (CBM)"  Width="120" Format="N3" TextAlign="TextAlign.Right" Visible="false" />
                <GridColumn Field="@nameof(JobRow.EstimatedValue)" HeaderText="Est. Value"    Width="120" Format="N2" TextAlign="TextAlign.Right" Visible="false" />
            </GridColumns>
        </SfGrid>
    </div>
</div>

<BsModalDialog @ref="_modal" />

@code {
    public record StatusFilter(string Value, string Label);

    /// <summary>Flattened row for the dashboard grid — built from JobOrder + the per-job bill rollup.</summary>
    public class JobRow
    {
        public long     JobId        { get; set; }
        public JobMode  RawMode      { get; set; }
        public string   JobNo        { get; set; } = "";
        public string   JobType      { get; set; } = "";   // Import / Export (ShipmentType)
        public string   Mode         { get; set; } = "";   // Clearance / Forwarding
        public string   Branch       { get; set; } = "";
        public string   Customer     { get; set; } = "";
        public string   Status       { get; set; } = "";
        public string   Verification { get; set; } = "";
        public string   Approval     { get; set; } = "";
        public string   BillStatus   { get; set; } = "";
        public DateTime CreatedDate  { get; set; }
        // Cargo Totals (optional columns)
        public decimal? GrossWeightKg  { get; set; }
        public decimal? VolumeCbm      { get; set; }
        public decimal? EstimatedValue { get; set; }
    }

    private SfGrid<JobRow>? _grid;
    private BsModalDialog?  _modal;
    private bool _loading = true;

    private List<JobOrderModel> _jobs = new();
    private Dictionary<long, JobBillInfo> _bills = new();
    private List<JobRow> _all      = new();
    private List<JobRow> _filtered = new();

    public EventCallback LoadOnSaveReference { get; set; }

    private string _activeCategory = "All";
    private string _activeStatus    = "ALL";

    private static readonly string[] _categories = { "All", "Clearance", "Forwarding", "Import", "Export" };
    private static readonly List<StatusFilter> _statuses = new()
    {
        new("ALL",       "All"),
        new("DRAFT",     "Draft"),
        new("SUBMITTED", "Submitted"),
        new("VERIFIED",  "Verified"),
        new("APPROVED",  "Approved"),
        new("REJECTED",  "Rejected"),
        new("CLOSED",    "Closed"),
    };

    // Dashboard KPI cards / deep-links may pass ?status=Approved etc.
    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LoadOnSaveReference = EventCallback.Factory.Create(this, Reload);

        if (!string.IsNullOrWhiteSpace(StatusQuery) &&
            _statuses.Any(s => s.Value.Equals(StatusQuery, StringComparison.OrdinalIgnoreCase)))
        {
            _activeStatus = _statuses.First(s => s.Value.Equals(StatusQuery, StringComparison.OrdinalIgnoreCase)).Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _jobs  = await JobService.GetAllAsync();
            _bills = await BillService.GetJobBillMapAsync();
            _all   = _jobs.Select(ToRow).ToList();
            ApplyFilter();
        }
        finally { _loading = false; StateHasChanged(); }
    }

    private JobRow ToRow(JobOrderModel j)
    {
        _bills.TryGetValue(j.Id, out var bill);
        return new JobRow
        {
            JobId        = j.Id,
            RawMode      = j.Mode,
            JobNo        = j.JobOrderNo,
            JobType      = j.ShipmentType.ToString(),
            Mode         = j.Mode.ToString(),
            Branch       = j.Branch?.BranchName ?? "—",
            Customer     = j.BillingClient?.CompanyName ?? "—",
            Status       = j.Status.ToString(),
            Verification = j.VerifiedOn.HasValue ? "Verified"
                         : j.Status == JobOrderStatus.Rejected ? "Rejected"
                         : j.Status >= JobOrderStatus.Submitted ? "Pending" : "—",
            Approval     = j.ApprovedOn.HasValue ? "Approved"
                         : j.Status == JobOrderStatus.Rejected ? "Rejected"
                         : j.Status >= JobOrderStatus.Verified ? "Pending" : "—",
            BillStatus   = bill is null ? "No Bill"
                         : bill.Issued ? $"{bill.Status} · Invoiced"
                         : bill.Status.ToString(),
            CreatedDate  = j.CreatedOn,
            GrossWeightKg  = j.GrossWeightKg,
            VolumeCbm      = j.VolumeCbm,
            EstimatedValue = j.EstimatedValue,
        };
    }

    private void SetCategory(string c) { _activeCategory = c; ApplyFilter(); }

    private void ApplyFilter()
    {
        IEnumerable<JobRow> q = _all;

        q = _activeCategory switch
        {
            "Clearance"  => q.Where(r => r.RawMode == JobMode.Clearance),
            "Forwarding" => q.Where(r => r.RawMode == JobMode.Forwarding),
            "Import"     => q.Where(r => r.JobType == nameof(JobShipmentType.Import)),
            "Export"     => q.Where(r => r.JobType == nameof(JobShipmentType.Export)),
            _            => q,
        };

        if (_activeStatus != "ALL")
            q = q.Where(r => r.Status.Equals(_activeStatus, StringComparison.OrdinalIgnoreCase));

        _filtered = q.ToList();
        StateHasChanged();
    }

    private async Task Reload() { await LoadData(); if (_grid is not null) await _grid.Refresh(); }

    private async Task OnOpen(CommandClickEventArgs<JobRow> args)
    {
        var row = args.RowData;
        var o = new BsModalOptions();
        o.ControlParameters.Add("Id", row.JobId);
        o.ControlParameters.Add("Title", $"{row.Mode} Job - {row.JobNo}");
        o.ControlParameters.Add("Mode", row.RawMode);
        o.ControlParameters.Add("LoadOnSaveReference", LoadOnSaveReference);
        var r = await _modal!.Context.ShowAsync<JobOrderPages.JobOrderPopup>(o);
        if (r.ResultType == ModalResultType.OK) await Reload();
    }
}
