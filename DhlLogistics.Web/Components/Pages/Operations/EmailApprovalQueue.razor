@page "/email-approvals"
@using System.Security.Claims
@using DhlLogistics.Web.Service.Ai
@using DhlLogistics.Shared.Models
@inject DraftApprovalService Approvals
@inject ShipmentFromDraftService ShipmentCreator
@inject AuthenticationStateProvider AuthState

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<div class="page-hdr">
    <div>
        <h1>Shipment Draft Approvals</h1>
        <div class="sub">Phase 3 · review AI-extracted drafts — no shipment is created until you approve</div>
    </div>
    <button class="btn-dhl-outline" @onclick="Reload">Refresh</button>
</div>

@if (_loading)
{
    <div class="loading-wrap">Loading queue…</div>
}
else
{
    <div class="equal-col" style="align-items:start;">

        <!-- ── Pending queue ─────────────────────────────────────────────── -->
        <div class="card">
            <div class="card-head">Pending <span class="tag">@_pending.Count</span></div>
            <div class="scroll-y" style="max-height:calc(100vh - 240px);">
                @if (_pending.Count == 0)
                {
                    <div class="sub" style="padding:12px;">Nothing awaiting approval.</div>
                }
                @foreach (var a in _pending)
                {
                    <div class="data-row @(_sel?.Id == a.Id ? "selected" : "")" @onclick="() => Select(a.Id)">
                        <div style="font-weight:600;">
                            @($"{a.ShipmentType ?? "?"} {a.Direction}".Trim())
                            @if (!a.HighConfidence)
                            {
                                <span class="tag" style="background:#fdecec;color:#b42318;">low</span>
                            }
                        </div>
                        <div class="sub">
                            @(a.DhlInvoiceNumber ?? a.EmailSubject) · @($"{a.Confidence:P0}") · @a.Provider
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ── Review panel ──────────────────────────────────────────────── -->
        <div class="card">
            <div class="card-head">Review Draft</div>
            @if (_sel is null)
            {
                <div class="sub" style="padding:12px;">Select a draft to review.</div>
            }
            else
            {
                <div style="padding:12px;">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                        <span class="pill @ConfidenceClass(_sel.Confidence)">
                            <span class="dot"></span>@($"{_sel.Confidence:P0}") · @_sel.Provider
                        </span>
                        <span class="tag">Email: @_sel.EmailSubject</span>
                    </div>

                    <div class="form-grid">
                        <label>Shipment Type
                            <select class="dhl-input" @bind="_sel.ShipmentType">
                                <option value="">—</option><option value="Air">Air</option><option value="Sea">Sea</option>
                            </select>
                        </label>
                        <label>Direction
                            <select class="dhl-input" @bind="_sel.Direction">
                                <option value="">—</option><option value="Import">Import</option><option value="Export">Export</option>
                            </select>
                        </label>
                        <label>Customer<input class="dhl-input" @bind="_sel.Customer" /></label>
                        <label>DHL Invoice No<input class="dhl-input" @bind="_sel.DhlInvoiceNumber" /></label>
                        <label>Container<input class="dhl-input" @bind="_sel.ContainerNumber" /></label>
                        <label>HAWB<input class="dhl-input" @bind="_sel.Hawb" /></label>
                        <label>MAWB<input class="dhl-input" @bind="_sel.Mawb" /></label>
                        <label>BL No<input class="dhl-input" @bind="_sel.BlNumber" /></label>
                        <label>Origin Port<input class="dhl-input" @bind="_sel.OriginPort" /></label>
                        <label>Destination Port<input class="dhl-input" @bind="_sel.DestinationPort" /></label>
                        <label>ETA<input type="date" class="dhl-input" @bind="_sel.Eta" /></label>
                        <label>ETD<input type="date" class="dhl-input" @bind="_sel.Etd" /></label>
                        <label>Reference Numbers<input class="dhl-input" @bind="_sel.ReferenceNumbers" /></label>
                    </div>

                    <div style="display:flex;gap:8px;align-items:center;margin-top:16px;flex-wrap:wrap;">
                        <button class="btn-dhl" disabled="@_busy" @onclick="Approve">Approve</button>
                        <button class="btn-dhl-outline" disabled="@_busy" @onclick="Save">Save Edits</button>
                        <button class="btn-dhl-outline" disabled="@_busy" @onclick="() => _showReject = true">Reject</button>
                        @if (_msg is not null) { <span class="sub">@_msg</span> }
                    </div>

                    @if (_showReject)
                    {
                        <div style="margin-top:12px;">
                            <label>Reason for rejection
                                <input class="dhl-input" @bind="_rejectReason" placeholder="Why is this draft rejected?" />
                            </label>
                            <div style="display:flex;gap:8px;margin-top:8px;">
                                <button class="btn-dhl" disabled="@_busy" @onclick="Reject">Confirm Reject</button>
                                <button class="btn-dhl-outline" @onclick="() => _showReject = false">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px 14px; }
    .form-grid label { display:flex; flex-direction:column; font-size:13px; color:#6b7280; gap:4px; }
    .pill.conf-hi  { background:#e6f7ec; color:#137a3b; }
    .pill.conf-mid { background:#fff5e0; color:#a86400; }
    .pill.conf-lo  { background:#fdecec; color:#b42318; }
</style>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _showReject;
    private string _rejectReason = string.Empty;
    private string? _msg;
    private string _reviewer = "User";

    private List<ShipmentDraftApproval> _pending = new();
    private ShipmentDraftApproval? _sel;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var u = state.User;
        _reviewer = u.FindFirst(ClaimTypes.Name)?.Value ?? u.Identity?.Name ?? "User";
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _pending = await Approvals.GetByStatusAsync(DraftApprovalStatus.Pending);
        _loading = false;
    }

    private async Task Select(int id)
    {
        _msg = null; _showReject = false; _rejectReason = string.Empty;
        _sel = await Approvals.GetByIdAsync(id);   // detached editable copy
    }

    private async Task Save()
    {
        if (_sel is null) return;
        _busy = true;
        _msg = await Approvals.SaveEditsAsync(_sel) ? "Edits saved." : "Draft is no longer pending.";
        _busy = false;
    }

    private async Task Approve()
    {
        if (_sel is null) return;
        _busy = true;
        var approvalId = _sel.Id;
        var ok = await Approvals.ApproveAsync(_sel, _reviewer);
        if (!ok) { _busy = false; _msg = "Draft is no longer pending."; return; }

        // Phase 4: approved → create the AWB / Sea shipment (reusing existing services).
        var result = await ShipmentCreator.CreateFromApprovedDraftAsync(approvalId);
        _busy = false;
        _sel = null;
        await Reload();
        _msg = result.Success
            ? $"Draft approved · {result.Message}"
            : $"Draft approved, but shipment not created: {result.Message}";
    }

    private async Task Reject()
    {
        if (_sel is null) return;
        _busy = true;
        var ok = await Approvals.RejectAsync(_sel.Id, _reviewer,
            string.IsNullOrWhiteSpace(_rejectReason) ? "Rejected" : _rejectReason);
        _busy = false;
        _showReject = false;
        if (ok) { _sel = null; await Reload(); _msg = "Draft rejected."; }
        else { _msg = "Draft is no longer pending."; }
    }

    private static string ConfidenceClass(double c) =>
        c >= 0.7 ? "conf-hi" : c >= 0.4 ? "conf-mid" : "conf-lo";
}
