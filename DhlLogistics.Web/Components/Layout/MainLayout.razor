@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotifSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ThemeService Theme
@inject LogisticsService Logistics
@inject GlobalSearchService GlobalSearch
@inject IDbContextFactory<AppDbContext> MenuFactory
@inject PermissionService Permissions
@inject ILogger<MainLayout> Logger
@using DhlLogistics.Web.Service.Search
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable

@if (_ready)
{
<div class="dhl-shell @(_collapsed ? "sidebar-collapsed" : "") @(_mobileOpen ? "sidebar-mobile-open" : "")">

    <!-- ── Glassmorphism sidebar (custom — no SfSidebar) ─────────────────────── -->
    <Sidebar Collapsed="_collapsed"
             UserName="@_userName"
             UserRole="@_userRole"
             UserInitial="@_userInitial"
             OnRequestExpand="ExpandSidebar" />

    <!-- Mobile drawer backdrop (only rendered when the drawer is open) -->
    @if (_mobileOpen)
    {
        <div class="sidebar-backdrop" @onclick="CloseMobileSidebar"></div>
    }

    <!-- ── Main area ─────────────────────────────────────────────────────────── -->
    <div class="dhl-main">

        <!-- Top bar -->
        <header class="dhl-topbar">

            <!-- Left: hamburger + title -->
            <div class="topbar-left">
                <button class="hamburger-btn" @onclick="ToggleSidebar"
                        aria-label="Toggle navigation" title="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
                <span class="topbar-title">@_pageTitle</span>
            </div>

            <!-- Right: search · date · notifications · user -->
            <div class="topbar-right">

                <!-- Global search -->
                <div class="search-wrap" @onclick:stopPropagation="true">
                    <div class="topbar-search">
                        <span class="search-icon" aria-hidden="true">🔍</span>
                        <input class="search-input" type="text" id="dhl-global-search"
                               placeholder="Search anything — jobs, invoices, AWB, containers, clients…  (Ctrl+K)"
                               aria-label="Search"
                               value="@_searchTerm"
                               @oninput="OnSearchInput"
                               @onfocus="OnSearchFocus"
                               @onkeydown="OnSearchKeyDown" />
                        @if (_searching)
                        {
                            <span class="search-spin" aria-hidden="true"></span>
                        }
                        @* Advanced Search toggle — shows a dot when any filter is active. *@
                        <button class="search-adv-btn @(_advOpen ? "on" : "")" type="button"
                                title="Advanced search" @onclick="ToggleAdvanced">
                            ⚙@(FilterCount > 0 ? $" {FilterCount}" : "")
                        </button>
                    </div>

                    @if (_advOpen)
                    {
                        <div class="search-adv glass">
                            <div class="adv-hdr">Advanced Search <span class="adv-note">filters combine (AND)</span></div>
                            <div class="adv-grid">
                                <div class="adv-f">
                                    <label>Module</label>
                                    <select @bind="_fModule">
                                        <option value="">All modules</option>
                                        @foreach (var m in GlobalSearch.Modules)
                                        {
                                            <option value="@m.Module">@m.Icon @m.Module</option>
                                        }
                                    </select>
                                </div>
                                <div class="adv-f">
                                    <label>Status</label>
                                    <input placeholder="e.g. Approved" @bind="_fStatus" />
                                </div>
                                <div class="adv-f">
                                    <label>Customer</label>
                                    <input placeholder="Customer name" @bind="_fCustomer" />
                                </div>
                                <div class="adv-f">
                                    <label>Branch</label>
                                    <input placeholder="Branch" @bind="_fBranch" />
                                </div>
                                <div class="adv-f">
                                    <label>Bill Type</label>
                                    <select @bind="_fBillType">
                                        <option value="">Any</option>
                                        <option value="Clearance">Clearance</option>
                                        <option value="Forwarding">Forwarding</option>
                                        <option value="Transportation">Transportation</option>
                                    </select>
                                </div>
                                <div class="adv-f">
                                    <label>Job Type</label>
                                    <select @bind="_fJobType">
                                        <option value="">Any</option>
                                        <option value="Clearance">Clearance</option>
                                        <option value="Forwarding">Forwarding</option>
                                    </select>
                                </div>
                                <div class="adv-f">
                                    <label>From</label>
                                    <input type="date" @bind="_fFrom" />
                                </div>
                                <div class="adv-f">
                                    <label>To</label>
                                    <input type="date" @bind="_fTo" />
                                </div>
                            </div>
                            <div class="adv-actions">
                                <button class="adv-btn" @onclick="ClearFilters">Clear</button>
                                <button class="adv-btn primary" @onclick="ApplyFilters">Apply</button>
                            </div>
                        </div>
                    }

                    @if (_searchOpen)
                    {
                        <div class="search-results glass">
                            @if (_searchTerm.Trim().Length < 2 && FilterCount == 0)
                            {
                                @* Recent + pinned searches (shown when the box is empty/short). *@
                                @if (_pinned.Count == 0 && _recent.Count == 0)
                                {
                                    <div class="search-empty">Type to search across every module.</div>
                                }
                                @if (_pinned.Count > 0)
                                {
                                    <div class="search-group-hdr">📌 Pinned</div>
                                    @foreach (var s in _pinned)
                                    {
                                        <div class="search-item" @onclick="() => RunRecent(s)">
                                            <span class="search-type">📌</span>
                                            <div class="search-item-main"><div class="search-item-title">@s</div></div>
                                            <span class="search-status" @onclick:stopPropagation="true" @onclick="() => Unpin(s)">✕</span>
                                        </div>
                                    }
                                }
                                @if (_recent.Count > 0)
                                {
                                    <div class="search-group-hdr">🕘 Recent</div>
                                    @foreach (var s in _recent)
                                    {
                                        <div class="search-item" @onclick="() => RunRecent(s)">
                                            <span class="search-type">🕘</span>
                                            <div class="search-item-main"><div class="search-item-title">@s</div></div>
                                            <span class="search-status" @onclick:stopPropagation="true" @onclick="() => Pin(s)">📌</span>
                                        </div>
                                    }
                                }
                            }
                            else if (_searching && (_searchResponse?.Total ?? 0) == 0)
                            {
                                <div class="search-empty">Searching…</div>
                            }
                            else if ((_searchResponse?.Total ?? 0) == 0)
                            {
                                <div class="search-empty">No matches for “@_searchTerm”</div>
                            }
                            else
                            {
                                var flatIndex = -1;
                                @foreach (var g in _searchResponse!.Groups)
                                {
                                    <div class="search-group-hdr">@g.Icon @g.Module <span class="search-count">(@g.Hits.Count)</span></div>
                                    @foreach (var h in g.Hits)
                                    {
                                        flatIndex++;
                                        var i = flatIndex;
                                        <div class="search-item @(i == _activeIndex ? "active" : "")" @onclick="() => OpenResult(h)">
                                            <span class="search-type">@h.Icon</span>
                                            <div class="search-item-main">
                                                @* Highlight the matched text inside the result. *@
                                                <div class="search-item-title">@Highlight(h.Primary)</div>
                                                @if (!string.IsNullOrWhiteSpace(h.Secondary) || h.Date is not null || !string.IsNullOrWhiteSpace(h.Branch))
                                                {
                                                    <div class="search-item-sub">
                                                        @Highlight(h.Secondary ?? "")@(string.IsNullOrWhiteSpace(h.Branch) ? "" : $" · {h.Branch}")@(h.Date is null ? "" : $" · {h.Date:dd MMM yyyy}")
                                                        @if (!string.IsNullOrWhiteSpace(h.Status))
                                                        {
                                                            <span> · </span><span class="search-status">@h.Status</span>
                                                        }
                                                    </div>
                                                }
                                                @* Related records — the Billing Group chain (Invoice → Bills → Jobs → Documents). *@
                                                @if (!string.IsNullOrWhiteSpace(h.Related))
                                                {
                                                    <div class="search-item-rel">🔗 @Highlight(h.Related!)</div>
                                                }
                                                @if (h.Actions.Count > 0)
                                                {
                                                    <div class="search-actions">
                                                        @foreach (var a in h.Actions)
                                                        {
                                                            <span class="search-action" title="@a.Label"
                                                                  @onclick:stopPropagation="true"
                                                                  @onclick="() => DoAction(h, a)">@a.Icon @a.Label</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(h.Status))
                                            {
                                                <span class="search-status">@h.Status</span>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                </div>

                <span class="tag mono">@DateTime.Now.ToString("dd MMM yyyy")</span>

                <!-- Notification bell -->
                <div class="notif-wrap">
                    <button class="notif-btn" @onclick="TogglePanel" @onclick:stopPropagation="true"
                            aria-label="Notifications">
                        🔔
                        @if (_unread > 0)
                        {
                            <span class="notif-badge">@(_unread > 9 ? "9+" : _unread.ToString())</span>
                        }
                    </button>

                    @if (_panelOpen)
                    {
                        <div class="notif-panel glass">
                            <div class="notif-panel-head">
                                <span>Notifications</span>
                                @if (_notifications.Any())
                                {
                                    <button class="notif-clear" @onclick="MarkAllRead">Mark all read</button>
                                }
                            </div>

                            @if (!_notifications.Any())
                            {
                                <div class="notif-empty">All caught up!</div>
                            }
                            else
                            {
                                @foreach (var n in _notifications)
                                {
                                    <div class="notif-item @(n.IsRead ? "read" : "")"
                                         @onclick="() => OpenNotification(n)">
                                        <div class="notif-icon">@TypeIcon(n.Type)</div>
                                        <div style="flex:1;min-width:0;">
                                            <div class="notif-title">@n.Title</div>
                                            <div class="notif-body">@n.Body</div>
                                            <div class="notif-time">@n.CreatedAt.ToString("HH:mm · dd MMM")</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- User avatar dropdown -->
                <div class="user-menu-wrap">
                    <button class="user-avatar-btn" @onclick="ToggleUserMenu" @onclick:stopPropagation="true"
                            aria-haspopup="true" aria-expanded="@(_userMenuOpen ? "true" : "false")">
                        <div class="avatar">@_userInitial</div>
                        <span class="user-name-label">@_userName</span>
                        <span class="chevron" aria-hidden="true">▾</span>
                    </button>

                    @if (_userMenuOpen)
                    {
                        <div class="user-dropdown glass">

                            <!-- User info header -->
                            <div class="user-dd-info">
                                <div class="avatar" style="width:38px;height:38px;font-size:15px;">@_userInitial</div>
                                <div>
                                    <div style="font-size:13px;font-weight:700;color:var(--text);">@_userName</div>
                                    <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;">@_userRole</div>
                                </div>
                            </div>

                            <div class="user-dd-divider"></div>

                            <!-- Theme selector -->
                            <div class="user-dd-theme">
                                <span style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;">Display</span>
                                <div class="theme-segmented" role="group" aria-label="Theme">
                                    <button class="theme-seg-btn @(!_darkMode ? "active" : "")"
                                            @onclick="() => SetTheme(false)">
                                        ☀ Light
                                    </button>
                                    <button class="theme-seg-btn @(_darkMode ? "active" : "")"
                                            @onclick="() => SetTheme(true)">
                                        ☾ Dark
                                    </button>
                                </div>
                            </div>

                            <div class="user-dd-divider"></div>

                            <a class="user-dd-item" href="/profile">
                                <span>👤</span> Profile
                            </a>
                            <a class="user-dd-item" href="/settings">
                                <span>⚙️</span> Settings
                            </a>
                            <div class="user-dd-divider"></div>
                            <a class="user-dd-item user-dd-logout" href="/Account/Logout">
                                <span>🚪</span> Logout
                            </a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Transparent backdrop — closes open panels when user clicks outside them -->
        @if (_panelOpen || _userMenuOpen || _searchOpen)
        {
            <div class="panels-backdrop" @onclick="CloseAllPanels"></div>
        }

        <!-- Page content -->
        <div class="dhl-page">
            @Body
        </div>
    </div>
</div>

<SfDialogProvider />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred. <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

<!-- Toast notification -->
@if (_toast is not null)
{
    <div class="toast-notif @(_toast.Visible ? "show" : "")">
        <div class="toast-icon">@TypeIcon(_toast.Type)</div>
        <div>
            <div class="toast-title">@_toast.Title</div>
            <div class="toast-body">@_toast.Body</div>
        </div>
        <button class="toast-close" @onclick="() => _toast = null">✕</button>
    </div>
}

<style>
/* ── Hamburger ──────────────────────────────────────────────────────────────── */
.topbar-left { display: flex; align-items: center; gap: 14px; }
.hamburger-btn {
    display: flex; flex-direction: column; justify-content: center;
    gap: 5px; background: none; border: none; cursor: pointer;
    padding: 6px; border-radius: 8px; width: 36px; height: 36px;
    transition: background .15s;
}
.hamburger-btn:hover { background: var(--surface2); }
.hamburger-btn span {
    display: block; height: 2px; border-radius: 2px;
    background: var(--muted); transition: background .15s;
}
.hamburger-btn:hover span { background: var(--red); }

/* ── Search box (glass) ─────────────────────────────────────────────────────── */
.topbar-search {
    display: flex; align-items: center; gap: 8px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    padding: 0 12px; height: 36px; min-width: 240px;
    transition: border-color .15s, box-shadow .15s;
}
.topbar-search:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(8,104,178,.15); }
.search-icon { font-size: 14px; flex-shrink: 0; }
.search-input {
    border: none; background: transparent; outline: none;
    font-size: 13px; color: var(--text); width: 100%;
}
.search-input::placeholder { color: var(--muted); }

/* ── Global search dropdown ─────────────────────────────────────────────────── */
.search-wrap { position: relative; }
.search-spin {
    width: 14px; height: 14px; flex-shrink: 0;
    border: 2px solid var(--border); border-top-color: var(--red);
    border-radius: 50%; animation: search-rotate .7s linear infinite;
}
@@keyframes search-rotate { to { transform: rotate(360deg); } }
.search-results {
    position: absolute; left: 0; top: calc(100% + 8px);
    width: 380px; max-width: 80vw; max-height: 420px; overflow-y: auto;
    border-radius: var(--radius); z-index: 1002; padding: 6px;
}
.search-empty { padding: 18px; text-align: center; color: var(--muted); font-size: 13px; }
.search-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 10px; border-radius: 8px; cursor: pointer;
    transition: background .12s;
}
.search-item:hover { background: var(--surface2); }
.search-type {
    flex-shrink: 0; font-size: 9.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .5px; color: var(--blue);
    background: rgba(8,104,178,.12); border-radius: 5px;
    padding: 3px 7px; min-width: 64px; text-align: center;
}
.search-item-main { flex: 1; min-width: 0; }
.search-item-title { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.search-item-sub { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Advanced Search ──────────────────────────────────────────────────────── */
.search-adv-btn {
    flex-shrink: 0; border: none; background: transparent; cursor: pointer;
    font-size: 12px; color: var(--muted); padding: 2px 6px; border-radius: 6px;
}
.search-adv-btn:hover { background: var(--surface2); color: var(--text); }
.search-adv-btn.on    { background: var(--blue); color: #fff; }

.search-adv {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 60;
    width: min(560px, 92vw); padding: 12px 14px;
    border: 1px solid var(--border); border-radius: 10px; box-shadow: var(--shadow);
}
.search-adv .adv-hdr {
    font-size: 12px; font-weight: 800; margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
}
.search-adv .adv-note { font-size: 10.5px; font-weight: 600; color: var(--muted); }
.search-adv .adv-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px 10px;
}
.search-adv .adv-f { display: flex; flex-direction: column; gap: 2px; }
.search-adv .adv-f label { font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
.search-adv .adv-f input,
.search-adv .adv-f select {
    font-size: 12px; padding: 4px 6px; border: 1px solid var(--border);
    border-radius: 6px; background: var(--card); color: var(--text);
}
.search-adv .adv-actions { display: flex; justify-content: flex-end; gap: 6px; margin-top: 10px; }
.search-adv .adv-btn {
    font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--card); color: var(--text); cursor: pointer;
}
.search-adv .adv-btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; }

/* Matched text inside a result. Transparent-ish so it reads in both themes. */
.search-mark {
    background: rgba(245, 180, 0, .35); color: inherit;
    border-radius: 3px; padding: 0 1px; font-weight: 700;
}
/* Related records — the Billing Group chain under a hit (Invoice → Bills → Jobs → Documents). */
.search-item-rel {
    font-size: 10.5px; color: var(--muted); margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    border-left: 2px solid var(--border); padding-left: 6px;
}
.search-status {
    flex-shrink: 0; font-size: 10px; font-weight: 600; color: var(--muted);
    background: var(--surface2); border-radius: 5px; padding: 2px 7px;
}
/* Grouped results: module header + count, active (keyboard) row, quick actions. */
.search-results { width: 440px; }
.search-group-hdr {
    font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px;
    color: var(--muted); padding: 8px 10px 4px; position: sticky; top: 0;
}
.search-count { opacity: .7; font-weight: 600; }
.search-item.active { background: var(--surface2); box-shadow: inset 0 0 0 1.5px rgba(8,104,178,.35); }
.search-actions { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 5px; }
.search-action {
    font-size: 10.5px; font-weight: 600; color: var(--blue);
    background: rgba(8,104,178,.10); border-radius: 5px; padding: 2px 7px; cursor: pointer;
}
.search-action:hover { background: rgba(8,104,178,.20); }

/* ── Notification bell ──────────────────────────────────────────────────────── */
.notif-wrap  { position: relative; }
.notif-btn   { background: none; border: none; font-size: 20px; cursor: pointer; position: relative; padding: 4px; border-radius: 8px; }
.notif-btn:hover { background: var(--surface2); }
.notif-badge {
    position: absolute; top: -2px; right: -4px;
    background: var(--red); color: #fff;
    font-size: 9px; font-weight: 800;
    min-width: 16px; height: 16px;
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    padding: 0 3px;
}
.notif-panel {
    position: absolute; right: 0; top: calc(100% + 10px);
    width: 340px; border-radius: var(--radius);
    z-index: 1000; overflow: hidden;
}
.notif-panel-head {
    padding: 12px 16px; font-size: 13px; font-weight: 700; color: var(--text);
    border-bottom: 1px solid var(--glass-border);
    display: flex; justify-content: space-between; align-items: center;
}
.notif-clear { font-size: 11px; color: var(--red); font-weight: 600; background: none; border: none; cursor: pointer; }
.notif-empty { padding: 24px; text-align: center; color: var(--muted); font-size: 13px; }
.notif-item {
    display: flex; gap: 10px; padding: 12px 16px;
    border-bottom: 1px solid var(--glass-border);
    cursor: pointer; background: rgba(171,25,33,.06); transition: background .12s;
}
.notif-item.read  { background: transparent; }
.notif-item:hover { background: var(--surface2); }
.notif-icon  { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
.notif-title { font-size: 13px; font-weight: 700; margin-bottom: 2px; color: var(--text); }
.notif-body  { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.notif-time  { font-size: 10px; color: var(--muted); margin-top: 4px; font-family: var(--mono); }

/* ── User menu ──────────────────────────────────────────────────────────────── */
.user-menu-wrap { position: relative; }
.user-avatar-btn {
    display: flex; align-items: center; gap: 8px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: 24px; padding: 4px 10px 4px 4px;
    cursor: pointer; transition: border-color .15s, box-shadow .15s;
}
.user-avatar-btn:hover { border-color: var(--red); box-shadow: 0 2px 10px rgba(171,25,33,.16); }
.user-name-label { font-size: 13px; font-weight: 600; color: var(--text); }
.chevron { font-size: 10px; color: var(--muted); }
.user-dropdown {
    position: absolute; right: 0; top: calc(100% + 10px);
    width: 210px; border-radius: var(--radius);
    z-index: 1001; overflow: hidden; padding: 4px 0;
}
.user-dd-info {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px 10px;
}
.user-dd-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px; font-size: 13px; color: var(--text);
    text-decoration: none; cursor: pointer; transition: background .12s;
}
.user-dd-item:hover { background: var(--surface2); }
.user-dd-logout { color: var(--red); }
.user-dd-divider { border-top: 1px solid var(--glass-border); margin: 4px 0; }

/* Theme selector */
.user-dd-theme {
    padding: 8px 14px 10px;
    display: flex; flex-direction: column; gap: 8px;
}
.theme-segmented {
    display: flex; border-radius: 8px; overflow: hidden;
    border: 1px solid var(--border); background: var(--surface2);
}
.theme-seg-btn {
    flex: 1; padding: 6px 0; font-size: 12px; font-weight: 600;
    border: none; background: transparent; cursor: pointer;
    color: var(--muted); transition: background .15s, color .15s;
    display: flex; align-items: center; justify-content: center; gap: 5px;
}
.theme-seg-btn.active {
    background: var(--card); color: var(--text);
    box-shadow: 0 1px 4px rgba(0,0,0,.12);
    border-radius: 6px;
}

/* ── Mobile drawer backdrop ─────────────────────────────────────────────────── */
.sidebar-backdrop {
    position: fixed; inset: 0; z-index: 35;
    background: rgba(2,6,23,.45);
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    animation: backdrop-in .2s ease;
}
@@keyframes backdrop-in { from { opacity: 0; } to { opacity: 1; } }
@@media (min-width: 769px) { .sidebar-backdrop { display: none; } }

/* ── Toast ──────────────────────────────────────────────────────────────────── */
.toast-notif {
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    background: var(--dark); color: #fff;
    border-radius: 12px; padding: 14px 16px;
    display: flex; align-items: flex-start; gap: 12px;
    max-width: 340px; box-shadow: 0 8px 32px rgba(0,0,0,.4);
    transform: translateY(120%); opacity: 0;
    transition: transform .3s ease, opacity .3s ease;
}
.toast-notif.show { transform: translateY(0); opacity: 1; }
.toast-icon  { font-size: 22px; flex-shrink: 0; }
.toast-title { font-size: 13px; font-weight: 700; margin-bottom: 3px; }
.toast-body  { font-size: 12px; color: rgba(255,255,255,.7); }
.toast-close { background: none; border: none; color: rgba(255,255,255,.5); cursor: pointer; font-size: 14px; margin-left: auto; flex-shrink: 0; }

/* ── Panel backdrop (click-outside to close) ────────────────────────────────── */
.panels-backdrop {
    position: fixed; inset: 0; z-index: 20;   /* below the topbar (30) so the dropdown is clickable; above page content for click-outside-to-close */
    background: transparent; cursor: default;
}

/* ── Responsive ─────────────────────────────────────────────────────────────── */
@@media (max-width: 767px) {
    .topbar-search { min-width: 0; width: 140px; }
    .user-name-label { display: none; }
    .tag.mono { display: none; }
}
@@media (max-width: 480px) {
    .topbar-search { display: none; }
}
</style>

@code {
    private bool _collapsed;          // desktop mini-rail (persisted)
    private bool _mobileOpen;         // mobile overlay drawer
    private bool _panelOpen;
    private bool _userMenuOpen;
    private bool _darkMode;
    private bool _ready;
    private string _pageTitle   = "Operations Dashboard";
    private string _userName    = "";
    private string _userRole    = "";
    private char   _userInitial = 'U';
    private string _userId      = "";
    private int    _unread;
    private List<NotificationDto> _notifications = [];
    private ToastModel?           _toast;
    private HubConnection?        _hub;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user  = state.User;

        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            Nav.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        _userName    = user.FindFirst(ClaimTypes.Name)?.Value
                       ?? user.Identity?.Name
                       ?? "User";
        _userRole    = user.FindFirst(ClaimTypes.Role)?.Value ?? "Viewer";
        _userId      = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        _userInitial = char.ToUpper(_userName.FirstOrDefault('U'));
        _ready       = true;

        // Auto-close the mobile drawer on navigation.
        Nav.LocationChanged += OnLocationChanged;

        await EnforcePagePermissionAsync();
    }

    /// <summary>
    /// Page-level authorisation. The sidebar only HIDES pages the user may not view — until now, typing the
    /// URL still opened them, so any authenticated user could reach /bills/approve, /accounts/* or
    /// /usermanagement regardless of role. (NoPermission.razor already existed; nothing ever routed to it.)
    ///
    /// <para>Enforced here, in the one layout every page renders through, rather than by adding an attribute
    /// to 77 pages — a page added later is covered automatically instead of being insecure by default.
    /// Pages with no Menus entry (e.g. /profile, /settings) are not permission-controlled and are allowed.</para>
    /// </summary>
    private async Task EnforcePagePermissionAsync()
    {
        var path = PermissionService.Normalise(Nav.ToBaseRelativePath(Nav.Uri));

        // Always-open routes: the dashboard, and the pages the guard itself redirects to.
        if (string.IsNullOrWhiteSpace(path)
            || path.StartsWith("no-permission", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("not-found", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("error", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("account/", StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            // Only pages that ARE permission-controlled (i.e. exist in the Menus table) are gated.
            await using var db = await MenuFactory.CreateDbContextAsync();
            var isControlled = await db.Menus.AsNoTracking()
                .AnyAsync(m => m.PageName != null && m.PageName != "" && m.RequiresPermission
                            && m.PageName.ToLower() == path.ToLower());
            if (!isControlled) return;

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (await Permissions.CheckPermissionAsync(state.User, path, Permission.View)) return;

            Nav.NavigateTo($"/no-permission/{Uri.EscapeDataString(path)}", forceLoad: false);
        }
        catch (Exception ex)
        {
            // A failure in the guard must not lock a legitimate user out of the whole app.
            Logger.LogWarning(ex, "Page permission check failed for '{Path}'; allowing.", path);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ready) return;

        // Sync theme + collapse state from localStorage (JS available now). The theme
        // attribute was already applied pre-paint by the App.razor boot script, so this
        // only mirrors that into C# — no flicker.
        await Theme.InitializeAsync();
        _darkMode = Theme.IsDark;
        try { _collapsed = await JS.InvokeAsync<bool>("dhlLayout.getCollapsed"); } catch { }
        StateHasChanged();

        // Global search shortcut — Ctrl+K / Ctrl+/ focus the search box from anywhere.
        try { await JS.InvokeVoidAsync("dhlSearch.bindShortcut", "dhl-global-search"); } catch { }

        await ConnectNotificationHubAsync();
        await RegisterWebPushAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_mobileOpen) { _mobileOpen = false; InvokeAsync(StateHasChanged); }

        // Re-check on EVERY navigation. Checking only on first render would let a user reach a restricted
        // page by navigating to it from inside the app rather than by loading its URL directly.
        _ = InvokeAsync(EnforcePagePermissionAsync);
    }

    // Hamburger: collapse the rail on desktop, open the drawer on mobile.
    private async Task ToggleSidebar()
    {
        bool isMobile;
        try { isMobile = await JS.InvokeAsync<bool>("dhlLayout.isMobile"); }
        catch { isMobile = false; }

        if (isMobile)
        {
            _mobileOpen = !_mobileOpen;
        }
        else
        {
            _collapsed = !_collapsed;
            try { await JS.InvokeVoidAsync("dhlLayout.setCollapsed", _collapsed); } catch { }
        }
    }

    private async Task ExpandSidebar()
    {
        _collapsed = false;
        try { await JS.InvokeVoidAsync("dhlLayout.setCollapsed", false); } catch { }
    }

    private void CloseMobileSidebar() => _mobileOpen = false;

    private async Task ConnectNotificationHubAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/notificationhub"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<NotificationDto>("Notify", async n =>
        {
            _notifications.Insert(0, n);
            _unread++;
            _toast = new ToastModel(n.Title, n.Body, n.Type);
            await InvokeAsync(StateHasChanged);
            await DismissToastAfterAsync(5000);
        });

        try { await _hub.StartAsync(); await _hub.SendAsync("JoinUserGroup", _userId, _userRole); }
        catch { /* hub offline in dev */ }
    }

    private async Task RegisterWebPushAsync()
    {
        await JS.InvokeVoidAsync("DhlPush.init", "/notificationhub", Nav.BaseUri);
    }

    private void TogglePanel()    { _panelOpen = !_panelOpen; _userMenuOpen = false; }
    private void ToggleUserMenu() { _userMenuOpen = !_userMenuOpen; _panelOpen = false; }
    private void CloseAllPanels() { _panelOpen = false; _userMenuOpen = false; _searchOpen = false; }

    // ── Universal Smart Search — debounced, grouped, keyboard-driven, permission-scoped ──────────
    private string _searchTerm = "";
    private bool   _searchOpen;
    private bool   _searching;
    private SearchResponse? _searchResponse;
    private int    _activeIndex = -1;
    private CancellationTokenSource? _searchCts;

    // Recent / pinned searches (client-side, localStorage — last 10).
    private List<string> _recent = new();
    private List<string> _pinned = new();
    private bool _recentLoaded;
    private const string RecentKey = "dhl.search.recent";
    private const string PinnedKey = "dhl.search.pinned";

    private IReadOnlyList<SearchHit> FlatHits() =>
        _searchResponse is null ? Array.Empty<SearchHit>()
        : _searchResponse.Groups.SelectMany(g => g.Hits).ToList();

    private async Task OnSearchFocus()
    {
        _panelOpen = false; _userMenuOpen = false;
        _searchOpen = true;
        if (!_recentLoaded) { await LoadRecentAsync(); _recentLoaded = true; }
    }

    // ── Advanced Search ──────────────────────────────────────────────────────
    private bool _advOpen;
    private string _fModule = "", _fStatus = "", _fCustomer = "", _fBranch = "", _fBillType = "", _fJobType = "";
    private DateTime? _fFrom, _fTo;

    /// <summary>How many filters are set — shown on the toggle so an active filter is never invisible.</summary>
    private int FilterCount =>
        (string.IsNullOrWhiteSpace(_fModule)   ? 0 : 1) + (string.IsNullOrWhiteSpace(_fStatus)   ? 0 : 1)
      + (string.IsNullOrWhiteSpace(_fCustomer) ? 0 : 1) + (string.IsNullOrWhiteSpace(_fBranch)   ? 0 : 1)
      + (string.IsNullOrWhiteSpace(_fBillType) ? 0 : 1) + (string.IsNullOrWhiteSpace(_fJobType)  ? 0 : 1)
      + (_fFrom is null ? 0 : 1) + (_fTo is null ? 0 : 1);

    private SearchFilter? BuildFilter()
    {
        if (FilterCount == 0) return null;
        var f = new SearchFilter
        {
            Status   = Blank(_fStatus),
            Customer = Blank(_fCustomer),
            Branch   = Blank(_fBranch),
            BillType = Blank(_fBillType),
            JobType  = Blank(_fJobType),
            From     = _fFrom,
            To       = _fTo,
        };
        if (!string.IsNullOrWhiteSpace(_fModule)) f.Modules.Add(_fModule);
        return f;

        static string? Blank(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    }

    private void ToggleAdvanced()
    {
        _advOpen = !_advOpen;
        if (_advOpen) { _searchOpen = false; _panelOpen = false; _userMenuOpen = false; }
    }

    private async Task ApplyFilters()
    {
        _advOpen = false;
        await OnSearchInput(new Microsoft.AspNetCore.Components.ChangeEventArgs { Value = _searchTerm });
    }

    private async Task ClearFilters()
    {
        _fModule = _fStatus = _fCustomer = _fBranch = _fBillType = _fJobType = "";
        _fFrom = _fTo = null;
        await OnSearchInput(new Microsoft.AspNetCore.Components.ChangeEventArgs { Value = _searchTerm });
    }

    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        _panelOpen = false; _userMenuOpen = false;
        _activeIndex = -1;

        _searchCts?.Cancel();

        var term = _searchTerm.Trim();
        // With an active Advanced filter a short/empty term is legitimate ("everything Approved in July").
        if (term.Length < 2 && FilterCount == 0)
        {
            _searching = false;
            _searchResponse = null;
            _searchOpen = true;                 // keep open to show recent/pinned
            return;
        }

        _searchOpen = true;
        _searching  = true;

        var cts = new CancellationTokenSource();
        _searchCts = cts;
        try
        {
            await Task.Delay(250, cts.Token);   // debounce
            var resp = await GlobalSearch.SearchAsync(term, BuildFilter(), cts.Token);
            if (cts.Token.IsCancellationRequested) return;
            _searchResponse = resp;
            _searching      = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
        catch (OperationCanceledException) { }
        catch
        {
            _searching = false;
            _searchResponse = null;
        }
    }

    /// <summary>
    /// Highlights the matched term inside a result. Matches the way the search itself matches — literally
    /// AND separator-insensitively — so "INV234354" highlights inside "INV-234354" too. HTML-escapes the text
    /// first: result text is user data and must never be injected as markup.
    /// </summary>
    private MarkupString Highlight(string text)
    {
        var term = _searchTerm.Trim();
        if (string.IsNullOrEmpty(text) || term.Length < 2)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var encoded = System.Net.WebUtility.HtmlEncode(text);

        // 1) literal match
        var idx = encoded.IndexOf(term, StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
            return (MarkupString)(encoded[..idx]
                + "<mark class=\"search-mark\">" + encoded.Substring(idx, term.Length) + "</mark>"
                + encoded[(idx + term.Length)..]);

        // 2) separator-insensitive match — walk the text ignoring - / and spaces.
        var stripped = SearchQuery.Strip(term);
        if (stripped.Length < 2) return (MarkupString)encoded;

        int si = 0, start = -1;
        for (int i = 0; i < encoded.Length && si < stripped.Length; i++)
        {
            var c = encoded[i];
            if (c is '-' or '/' or ' ' or '.') continue;               // separators are skippable
            if (char.ToLowerInvariant(c) == stripped[si]) { if (si == 0) start = i; si++; }
            else { si = 0; start = -1; }
        }
        if (si == stripped.Length && start >= 0)
        {
            // find where the run ended
            int end = start, matched = 0;
            while (end < encoded.Length && matched < stripped.Length)
            {
                if (encoded[end] is not ('-' or '/' or ' ' or '.')) matched++;
                end++;
            }
            return (MarkupString)(encoded[..start]
                + "<mark class=\"search-mark\">" + encoded[start..end] + "</mark>"
                + encoded[end..]);
        }
        return (MarkupString)encoded;
    }

    private void OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var hits = FlatHits();
        switch (e.Key)
        {
            case "ArrowDown":
                if (hits.Count > 0) _activeIndex = Math.Min(_activeIndex + 1, hits.Count - 1);
                break;
            case "ArrowUp":
                if (hits.Count > 0) _activeIndex = Math.Max(_activeIndex - 1, 0);
                break;
            case "Enter":
                if (_activeIndex >= 0 && _activeIndex < hits.Count) _ = OpenResult(hits[_activeIndex]);
                else if (hits.Count > 0) _ = OpenResult(hits[0]);
                break;
            case "Escape":
                _searchOpen = false;
                break;
        }
    }

    private async Task OpenResult(SearchHit h)
    {
        await PushRecentAsync(_searchTerm.Trim());
        _ = GlobalSearch.LogOpenAsync(_searchTerm.Trim(), h.Module, h.Primary);
        CloseSearch();
        Nav.NavigateTo(h.Url);
    }

    private async Task DoAction(SearchHit h, QuickAction a)
    {
        await PushRecentAsync(_searchTerm.Trim());
        _ = GlobalSearch.LogOpenAsync(_searchTerm.Trim(), h.Module, $"{h.Primary} · {a.Label}");
        CloseSearch();
        Nav.NavigateTo(a.Url);
    }

    private void CloseSearch()
    {
        _searchOpen = false;
        _searchTerm = "";
        _searchResponse = null;
        _activeIndex = -1;
    }

    private async Task RunRecent(string s)
    {
        _searchTerm = s;
        await OnSearchInput(new Microsoft.AspNetCore.Components.ChangeEventArgs { Value = s });
    }

    // ── Recent / pinned persistence (localStorage) ──────────────────────────────
    private async Task LoadRecentAsync()
    {
        _recent = await ReadListAsync(RecentKey);
        _pinned = await ReadListAsync(PinnedKey);
    }

    private async Task<List<string>> ReadListAsync(string key)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            if (string.IsNullOrWhiteSpace(json)) return new();
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new();
        }
        catch { return new(); }
    }

    private async Task SaveListAsync(string key, List<string> list)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, System.Text.Json.JsonSerializer.Serialize(list)); }
        catch { /* private mode / SSR — non-fatal */ }
    }

    private async Task PushRecentAsync(string term)
    {
        if (term.Length < 2) return;
        _recent.RemoveAll(x => string.Equals(x, term, StringComparison.OrdinalIgnoreCase));
        _recent.Insert(0, term);
        if (_recent.Count > 10) _recent = _recent.Take(10).ToList();
        await SaveListAsync(RecentKey, _recent);
    }

    private async Task Pin(string s)
    {
        if (!_pinned.Contains(s)) { _pinned.Insert(0, s); await SaveListAsync(PinnedKey, _pinned); }
    }

    private async Task Unpin(string s)
    {
        _pinned.Remove(s);
        await SaveListAsync(PinnedKey, _pinned);
    }

    private async Task SetTheme(bool dark)
    {
        _darkMode = dark;
        await Theme.SetDarkAsync(dark);
    }

    private async Task MarkAllRead()
    {
        foreach (var n in _notifications) { n.IsRead = true; await NotifSvc.MarkReadAsync(n.Id); }
        _unread = 0;
        StateHasChanged();
    }

    private void OpenNotification(NotificationDto n)
    {
        n.IsRead   = true;
        _unread    = Math.Max(0, _unread - 1);
        _panelOpen = false;
        if (n.JobCode is not null) Nav.NavigateTo("/jobs");
    }

    private async Task DismissToastAfterAsync(int ms)
    {
        await Task.Delay(ms);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        if (_hub is not null) await _hub.DisposeAsync();
    }

    protected override async Task OnParametersSetAsync() => await SetPageTitleAsync();

    /// <summary>
    /// Page title, resolved from the DB-driven Menus table — the same source of truth the sidebar uses.
    ///
    /// <para>This replaced a hardcoded switch over the last URL segment whose fallback was
    /// "Operations Dashboard", so EVERY page outside that short list (all the billing screens, Customer
    /// Invoices, masters, reports…) displayed the wrong title. Deriving it from the menu means a page added
    /// later gets the right title with no change here.</para>
    ///
    /// <para>Falls back to a prettified URL segment for routes that have no menu entry (e.g. /profile),
    /// and never to another page's name.</para>
    /// </summary>
    private async Task SetPageTitleAsync()
    {
        var path = PermissionService.Normalise(Nav.ToBaseRelativePath(Nav.Uri));
        if (string.IsNullOrWhiteSpace(path)) { _pageTitle = "Dashboard"; return; }

        try
        {
            await using var db = await MenuFactory.CreateDbContextAsync();
            var match = await db.Menus.AsNoTracking()
                .Where(m => m.PageName != null && m.PageName != "")
                .Select(m => new { m.MenuName, m.PageName })
                .ToListAsync();

            // Longest matching page-path wins, so /bills/customer-invoices beats /bills.
            var best = match
                .Where(m => path.Equals(PermissionService.Normalise(m.PageName!), StringComparison.OrdinalIgnoreCase))
                .Select(m => m.MenuName)
                .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(best)) { _pageTitle = best!; return; }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Page-title lookup failed; falling back to the URL segment.");
        }

        // No menu entry — prettify the last segment ("customer-invoices" → "Customer Invoices").
        var seg = path.Split('/').LastOrDefault() ?? "";
        _pageTitle = string.IsNullOrWhiteSpace(seg)
            ? "Dashboard"
            : string.Join(' ', seg.Split('-', '_')
                .Where(w => w.Length > 0)
                .Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    private static string TypeIcon(string type) => type switch
    {
        "NewJob"        => "📦",
        "JobAssigned"   => "👤",
        "StatusChanged" => "🔄",
        "Alert"         => "⚠️",
        _               => "🔔",
    };

    private record ToastModel(string Title, string Body, string Type)
    {
        public bool Visible { get; init; } = true;
    }
}
